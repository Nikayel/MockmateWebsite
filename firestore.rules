rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // HELPER FUNCTIONS
    // ============================================================================

    /**
     * Check if the user is authenticated
     */
    function isAuthenticated() {
      return request.auth != null;
    }

    /**
     * Check if the authenticated user matches the document's userId
     */
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /**
     * Check if the user is creating their own document
     * Note: This is a generic helper - specific collections may use different field names
     */
    function isCreatingOwnDocument(userId) {
      return isAuthenticated()
        && request.auth.uid == userId
        && (request.resource.data.userId == userId || request.resource.data.user_id == userId || request.resource.data.id == userId);
    }

    /**
     * Validate that required fields exist in the document
     */
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    /**
     * Check if the document exists
     */
    function documentExists() {
      return resource != null;
    }

    /**
     * Profile fields the client may never write.
     *
     * `profiles.subscription_tier` IS the entitlement store: it is read directly by
     * lib/quota-enforcement.ts and lib/quota/session-start-admin.ts, so a client
     * write to any of these is a billing decision. Every legitimate writer
     * (lib/stripe-helpers.ts, the Stripe webhook, the cron routes) goes through the
     * Admin SDK, which bypasses these rules entirely, so nothing real is blocked.
     *
     * `created_at` is here because it is the anniversary input to
     * lib/quota/billing-period.ts. Rolling it forward moves the billing window so no
     * existing profile_quota doc matches, and sessionsUsed reads 0 again. The
     * "most-conservative doc wins" defense in quota-enforcement only picks the max
     * among docs already IN the window, so moving the window sidesteps it.
     *
     * `custom_budget_cap` is honored by lib/usage/budget.ts up to $10,000.
     */
    function serverOnlyProfileFields() {
      return [
        'subscription_tier',
        'subscription_status',
        'subscription_type',
        'subscription_platform',
        'subscription_start_date',
        'subscription_current_period_end',
        'stripe_customer_id',
        'stripe_subscription_id',
        'custom_budget_cap',
        'created_at'
      ];
    }

    // ============================================================================
    // USER PROFILES
    // ============================================================================

    match /profiles/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);

      // Users can create their own profile.
      //
      // The create rule previously validated only that three fields were PRESENT,
      // never what they contained, while delete was open to the owner. Together
      // those let any signed-in user delete their profile and recreate it with
      // subscription_tier: 'pro' straight from the browser console, using the
      // public Firebase config that ships in the bundle by design. Neither
      // self-heal catches it: lib/firestore-helpers.ts only syncs when a Stripe id
      // is present, and the subscription-reconcile cron only scans profiles that
      // already carry stripe_subscription_id. The forged entitlement was permanent
      // and silent.
      //
      // A profile can therefore only ever be born on the free tier. The app's own
      // createOrUpdateProfile writes exactly this shape, so nothing legitimate breaks.
      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.id == userId
                    && hasRequiredFields(['id', 'email', 'created_at'])
                    && (!('subscription_tier' in request.resource.data)
                        || request.resource.data.subscription_tier == 'free')
                    && !request.resource.data.keys().hasAny(
                         serverOnlyProfileFields().removeAll(['subscription_tier', 'created_at']));

      // Users can update their own profile, but never the billing-controlled fields.
      allow update: if isOwner(userId)
                    && request.resource.data.id == userId
                    && resource.data.id == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(serverOnlyProfileFields());

      // Deletion is server-side only. app/api/delete-account/route.ts performs it
      // through the Admin SDK, which bypasses these rules, and no client code path
      // deletes a profile. Leaving this open to the owner was half of the
      // delete-and-recreate entitlement forgery described above.
      allow delete: if false;
    }

    // ============================================================================
    // INTERVIEW SESSIONS
    // ============================================================================

    match /interview_sessions/{sessionId} {
      // Users can read their own sessions
      allow read: if isAuthenticated()
                  && documentExists()
                  && resource.data.user_id == request.auth.uid;

      // Users can create their own sessions
      allow create: if isAuthenticated()
                    && request.resource.data.user_id == request.auth.uid;

      // Users can update their own sessions
      allow update: if isAuthenticated()
                    && documentExists()
                    && resource.data.user_id == request.auth.uid
                    && request.resource.data.user_id == request.auth.uid;

      // Users can delete their own sessions
      allow delete: if isAuthenticated()
                    && documentExists()
                    && resource.data.user_id == request.auth.uid;

      // Performance optimization: Create index for common queries
      // Run in Firebase Console:
      // firebase firestore:indexes --project=your-project-id
      //
      // Composite indexes needed:
      // 1. Collection: interview_sessions, Fields: user_id ASC, started_at DESC
      // 2. Collection: interview_sessions, Fields: user_id ASC, status ASC, started_at DESC
    }

    // ============================================================================
    // PROMO CODE USAGE
    // ============================================================================

    match /promo_code_usage/{docId} {
      // Users can read their own promo code usage
      allow read: if isAuthenticated()
                  && documentExists()
                  && resource.data.user_id == request.auth.uid;

      // Users can create promo code usage records
      // Document ID must be in format: {userId}_{code}
      allow create: if isAuthenticated()
                    && request.resource.data.user_id == request.auth.uid
                    && docId.matches(request.auth.uid + '_.*')
                    && hasRequiredFields(['user_id', 'code', 'usedAt']);

      // Promo code usage records are immutable (no updates or deletes)
      allow update: if false;
      allow delete: if false;
    }

    // ============================================================================
    // PROFILE QUOTA (Usage tracking)
    // ============================================================================

    match /profile_quota/{quotaId} {
      // Users can read their own quota data
      allow read: if isAuthenticated()
                  && documentExists()
                  && resource.data.user_id == request.auth.uid;

      // QUOTA-1: profile_quota is SERVER-AUTHORITATIVE. All mutations go
      // through the Admin SDK (POST /api/usage/session-start for session
      // starts; lib/stripe-helpers for billing resets), which bypasses these
      // rules. Client writes — including the old zero-usage create and the
      // recordSessionStart state transitions — are disabled entirely.
      // DEPLOY ORDER: ship the app (API route + client flip) BEFORE deploying
      // these rules, or older client bundles fail to start sessions.
      allow create: if false;
      allow update: if false;

      // Users cannot delete quota records (immutable history)
      allow delete: if false;
    }

    // ============================================================================
    // SUBSCRIPTION DATA (Read-only from client)
    // ============================================================================

    match /subscriptions/{userId} {
      // Users can read their own subscription data
      allow read: if isOwner(userId);

      // Only server can write subscription data (via Admin SDK)
      // Client cannot create, update, or delete subscriptions
      allow write: if false;
    }

    // ============================================================================
    // PAYMENT HISTORY (Read-only from client)
    // ============================================================================

    match /payment_history/{paymentId} {
      // Users can read their own payment history
      allow read: if isAuthenticated()
                  && documentExists()
                  && resource.data.user_id == request.auth.uid;

      // Only server can write payment history (via Admin SDK from Stripe webhooks)
      // Client cannot create, update, or delete payment records
      allow write: if false;
    }

    // ============================================================================
    // ANALYTICS & METRICS (Write-only from client)
    // ============================================================================

    // Analytics are written server-side via the Admin SDK (see
    // lib/analytics-server.ts), which bypasses these rules. No client access.
    // (Previously this allowed any authenticated user to create documents in an
    // unused `analytics` collection; the real telemetry collection is
    // `analytics_events`, which stays default-deny for clients.)
    match /analytics/{document=**} {
      allow read, write: if false;
    }

    // ============================================================================
    // ADMIN COLLECTIONS (Admin SDK only)
    // ============================================================================

    match /admin/{document=**} {
      // No client access - only Firebase Admin SDK
      allow read, write: if false;
    }

    match /system/{document=**} {
      // No client access - only Firebase Admin SDK
      allow read, write: if false;
    }

    // ============================================================================
    // RAG COLLECTIONS - TEXT EMBEDDINGS
    // ============================================================================

    match /text_embeddings/{embeddingId} {
      // Problems and hints: Read-only for all authenticated users
      // Solutions: Only readable by the owning user
      allow read: if isAuthenticated() && (
        // Public: problems and hints
        resource.data.type == 'problem' || 
        resource.data.type == 'hint' ||
        // Private: user's own solutions
        (resource.data.type == 'solution' && 
         resource.data.metadata.user_id == request.auth.uid)
      );

      // Only backend (Admin SDK) can write embeddings
      // Clients cannot create/update/delete embeddings directly
      allow write: if false;
    }

    // ============================================================================
    // RAG COLLECTIONS - SESSION VECTORS
    // ============================================================================

    match /session_vectors/{vectorId} {
      // Users can read their own session vectors
      allow read: if isAuthenticated() 
                  && documentExists()
                  && resource.data.user_id == request.auth.uid;

      // Only backend (Admin SDK) can write session vectors
      // Clients cannot create/update/delete vectors directly
      allow write: if false;
    }

    // ============================================================================
    // RAG COLLECTIONS - PERFORMANCE PROFILES
    // ============================================================================

    match /performance_profiles/{userId} {
      // Users can read their own performance profile
      allow read: if isOwner(userId);

      // Only backend (Admin SDK) can write performance profiles
      // Clients cannot create/update/delete profiles directly
      allow write: if false;
    }

    // ============================================================================
    // RAG COLLECTIONS - RAG TRACES (Audit Logging)
    // ============================================================================

    match /rag_traces/{traceId} {
      // Users can read their own RAG traces (for debugging)
      allow read: if isAuthenticated() 
                  && documentExists()
                  && resource.data.user_id == request.auth.uid;

      // Only backend (Admin SDK) can write traces
      // Clients cannot create/update/delete traces directly
      allow write: if false;
    }

    // ============================================================================
    // NOTIFICATION SYSTEM
    // ============================================================================

    match /notification_preferences/{userId} {
      // Users can read/write their own notification preferences
      allow read: if isOwner(userId);
      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.userId == userId;
      allow update: if isOwner(userId)
                    && request.resource.data.userId == userId;
      allow delete: if isOwner(userId);
    }

    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated()
                  && documentExists()
                  && resource.data.userId == request.auth.uid;

      // Users can update their own notifications (mark as read/dismissed)
      allow update: if isAuthenticated()
                    && documentExists()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      // Only backend can create/delete notifications
      allow create: if false;
      allow delete: if false;
    }

    match /in_app_notifications/{notificationId} {
      // Users can read their own in-app notifications
      allow read: if isAuthenticated()
                  && documentExists()
                  && resource.data.userId == request.auth.uid;

      // Users can update (mark as read/dismissed) their OWN notifications.
      // The owner must stay pinned to the caller, otherwise a user could
      // reassign a notification they own to a victim (notification injection).
      // Restrict mutable keys to the read/dismiss state so title/body/link
      // (potential phishing content) cannot be rewritten client-side.
      allow update: if isAuthenticated()
                    && documentExists()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['read', 'readAt', 'dismissed', 'dismissedAt']);

      // Only backend can create in-app notifications
      allow create: if false;
      allow delete: if false;
    }

    match /notification_analytics/{userId} {
      // Users can read their own notification analytics
      allow read: if isOwner(userId);

      // Only backend can write analytics
      allow write: if false;
    }

    match /notification_queue/{queueId} {
      // No client access - only Firebase Admin SDK
      allow read, write: if false;
    }

    // ============================================================================
    // CASE LAB RUNS (Labs workbook)
    // ============================================================================

    // Owner-only access. Authoritative writes go through the Firebase Admin SDK
    // in app/api/labs/* (which bypasses these rules and already verifies the
    // token + ownership), so this block is defense-in-depth for any future
    // direct-client SDK access. CaseLabRun docs carry a server-derived `userId`
    // field that the client cannot set/spoof.
    match /caseLabRuns/{runId} {
      allow read: if isAuthenticated()
                  && documentExists()
                  && resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated()
                    && documentExists()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      allow delete: if isAuthenticated()
                    && documentExists()
                    && resource.data.userId == request.auth.uid;
    }

    // Owner-only access for interactive Python tutorial progress. Authoritative
    // writes go through the Firebase Admin SDK in app/api/tutorials/progress (which
    // verifies the token + ownership and bypasses these rules), so this block is
    // defense-in-depth for any future direct-client SDK access. Docs carry a
    // server-derived `userId` field that the client cannot set/spoof.
    match /user_tutorial_progress/{docId} {
      allow read: if isAuthenticated()
                  && documentExists()
                  && resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated()
                    && documentExists()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      allow delete: if isAuthenticated()
                    && documentExists()
                    && resource.data.userId == request.auth.uid;
    }

    // Research-participation consent. Authoritative writes go through the Admin SDK in
    // app/api/research-consent (token + ownership verified). Reads are owner-only so a
    // learner can always see the choice on record for them.
    match /user_research_consent/{userId} {
      allow read: if isAuthenticated() && userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Item-level Learn research telemetry (one append-only row per exercise run, check
    // answer, and hint reveal). Writes are Admin-SDK-only through
    // app/api/tutorials/item-responses — there is deliberately NO client create/update
    // path, because a learner able to forge or amend their own response log would
    // invalidate every research use this collection exists for. Owner-only reads keep
    // per-user export working without exposing one learner's trajectory to another.
    match /learn_item_responses/{docId} {
      allow read: if isAuthenticated()
                  && documentExists()
                  && resource.data.user_id == request.auth.uid;

      allow create, update, delete: if false;
    }

    // Owner-only access for System-Design free-response answers (the learner's private work
    // product). Same discipline as user_tutorial_progress above: authoritative writes go through the
    // Firebase Admin SDK in app/api/tutorials/design-answers (token + ownership verified), so this
    // block is defense-in-depth for any future direct-client SDK access. Docs carry a server-derived
    // `userId` field the client cannot set/spoof; the doc id is prefixed `${uid}__`.
    match /user_design_answers/{docId} {
      allow read: if isAuthenticated()
                  && documentExists()
                  && resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated()
                    && documentExists()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      allow delete: if isAuthenticated()
                    && documentExists()
                    && resource.data.userId == request.auth.uid;
    }

    // ============================================================================
    // AI USAGE & COST DATA (server-only — Admin SDK writes; no client access)
    // ============================================================================
    // These collections drive per-user budget enforcement and the global daily
    // spend ceiling. They MUST never be client-writable: a client write could
    // zero out recorded usage to bypass budget caps, or tamper with the global
    // cost kill-switch. All legitimate writes happen server-side via the Admin
    // SDK (which bypasses these rules). Reads of budget state also go through
    // server API routes, never direct client SDK. Explicit here (rather than
    // relying on the default-deny below) so the posture is auditable.

    // Per-call usage events (collection) used for cost aggregation.
    match /usage_events/{eventId} {
      allow read, write: if false;
    }

    // Aggregate global daily spend counter (global cost kill-switch backstop).
    match /global_usage/{dayId} {
      allow read, write: if false;
    }

    // A user may read their OWN session summaries, and only those.
    //
    // app/sessions/[id]/page.tsx falls back to users/{uid}/session_summaries/{id}
    // for the score breakdown when the session document lacks one, using the
    // client SDK. The catch-all below denied it, so that fallback threw on every
    // session and the throw was swallowed: the breakdown simply never appeared.
    //
    // Firestore grants access when ANY matching rule allows, so this narrower
    // match opens exactly this subcollection while the catch-all continues to
    // contribute nothing. Writes stay server-only: only lib/session-metrics.ts
    // through the Admin SDK produces these documents.
    match /users/{userId}/session_summaries/{summaryId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Per-user usage summaries live at users/{uid}/usage_summaries/{period};
    // the rest of the users/* tree is server-only (budget state is read via API).
    match /users/{userId}/{document=**} {
      allow read, write: if false;
    }

    // ============================================================================
    // OPEN LEARNER MODEL & SPACED-REPETITION STATE (server-only — Admin SDK)
    // ============================================================================
    // The learner model exposes the system's beliefs for inspection, challenge,
    // and correction. Every one of these collections is written exclusively by
    // API routes via the Admin SDK (which bypasses these rules), and read back
    // through those same routes. Client access must stay closed because:
    //
    //  - learner_model_challenges holds the research record of every dispute AND
    //    its verification outcome. A client write could fabricate "my challenge
    //    was right", corrupting both the user's schedule and the study data.
    //  - learner_model_events are the study's dependent variables; forged events
    //    would silently poison any analysis.
    //  - problem_mastery is the scheduler's memory state (stability, difficulty,
    //    lapses, due dates). A client write is a self-grading vector: a user
    //    could mark everything mastered and defeat spaced repetition entirely.
    //  - algorithm_research_events carry the pre/post FSRS card snapshots the
    //    challenge amendment replays from. Tampering there would let a client
    //    steer the corrected schedule.
    //  - research_config is the GLOBAL scheduler switch (ab_ended /
    //    default_algorithm). A client write would change algorithm routing for
    //    every user on the platform.
    //
    // Explicit here (rather than relying on the default-deny below) so the
    // posture is auditable.

    match /learner_model_challenges/{challengeId} {
      allow read, write: if false;
    }

    match /learner_model_events/{eventId} {
      allow read, write: if false;
    }

    match /problem_mastery/{userId}/{document=**} {
      allow read, write: if false;
    }

    match /algorithm_research_events/{eventId} {
      allow read, write: if false;
    }

    match /algorithm_research_metrics/{userId}/{document=**} {
      allow read, write: if false;
    }

    match /algorithm_research_aggregate/{docId} {
      allow read, write: if false;
    }

    match /research_config/{docId} {
      allow read, write: if false;
    }

    // ============================================================================
    // DEFAULT DENY ALL
    // ============================================================================

    // Deny access to all other documents by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ============================================================================
// DEPLOYMENT INSTRUCTIONS
// ============================================================================
//
// To deploy these rules to Firebase:
//
// 1. Install Firebase CLI (if not already installed):
//    npm install -g firebase-tools
//
// 2. Login to Firebase:
//    firebase login
//
// 3. Initialize Firestore in your project (if not already done):
//    firebase init firestore
//    (Select your Firebase project and use firestore.rules as the rules file)
//
// 4. Deploy the rules:
//    firebase deploy --only firestore:rules
//
// 5. Verify deployment:
//    - Go to Firebase Console > Firestore Database > Rules
//    - Check that the rules are active
//
// 6. Test the rules (optional):
//    firebase emulators:start --only firestore
//    (Then run your app against the emulator to test)
//
// ============================================================================
// SECURITY BEST PRACTICES
// ============================================================================
//
// 1. Always authenticate users before granting access
// 2. Verify ownership - users should only access their own data
// 3. Validate all writes - check required fields and data types
// 4. Use document IDs that include user IDs for ownership verification
// 5. Implement read/write limits to prevent abuse
// 6. Never trust client-provided user IDs - always use request.auth.uid
// 7. Keep rules simple and maintainable
// 8. Test rules thoroughly before deploying to production
// 9. Monitor Firestore usage for suspicious patterns
// 10. Regularly audit and update security rules
//
// ============================================================================
// COMMON QUERIES AND INDEXES
// ============================================================================
//
// These composite indexes are recommended for optimal performance:
//
// Collection: interview_sessions
// - Fields: user_id (Ascending), started_at (Descending)
// - Query: Get user's recent sessions
//
// Collection: interview_sessions
// - Fields: user_id (Ascending), status (Ascending), started_at (Descending)
// - Query: Get user's active/completed sessions
//
// Collection: promo_code_usage
// - Fields: user_id (Ascending), usedAt (Descending)
// - Query: Get user's promo code history
//
// Collection: profile_quota
// - Fields: user_id (Ascending), period_start (Descending)
// - Query: Get user's quota history
//
// To create indexes, run:
// firebase firestore:indexes --project=your-project-id
//
