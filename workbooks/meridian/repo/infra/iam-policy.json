{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MeridianApiDocumentStorage",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": "*"
    },
    {
      "Sid": "MeridianApiLogging",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:482913005577:log-group:/ecs/meridian-api:*"
    }
  ]
}
