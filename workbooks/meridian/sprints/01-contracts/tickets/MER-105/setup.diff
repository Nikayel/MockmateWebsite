+/**
+ * Normalizes the amount to two decimal places before handing off to the real parser, so a
+ * plain JS number keeps the exact shape Finance expects on the wire. Falls back to the
+ * caller's own payload, unparsed, whenever normalizing it throws - stops CLM-77102-shaped
+ * payloads from ever 500ing again. See PR #412.
+ */
+export function parseCreateClaimBody(body: unknown): ParseClaimInputResult {
+  try {
+    const record = (body ?? {}) as Record<string, unknown>
+    const rawAmount = record.amount as { toFixed(digits: number): string }
+    const normalizedAmount = Number(rawAmount.toFixed(2))
+    return parseClaimInput({ ...record, amount: normalizedAmount })
+  } catch {
+    return { ok: true, value: body as ParsedClaimInput }
+  }
+}
+
 export function registerClaimRoutes(app: App, deps: ClaimRouteDeps): void {
   app.post("/claims", async (req) => {
     const tenantId = requireTenantId(req)
-    const parsed = parseClaimInput(req.body)
+    const parsed = parseCreateClaimBody(req.body)
     if (!parsed.ok) {
       return badRequest({ message: parsed.reason, correlationId: req.correlationId })
     }
