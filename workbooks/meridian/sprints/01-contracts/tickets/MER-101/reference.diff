@@ -0,0 +1,67 @@
+/**
+ * The one place an untrusted claim payload gets narrowed into something the rest of the
+ * system can trust. `parseClaimInput` takes `unknown` - never `any` - and returns a
+ * discriminated union: an invalid claim cannot be represented past this function's return
+ * statement, because there is no shape a caller can hold that claims to be a valid claim
+ * without actually being one.
+ */
+
+/** What a caller must give us to open a claim, once it has been checked field by field. */
+export interface ParsedClaimInput {
+  externalRef: string
+  amount: number
+  currency: string
+  claimantName: string
+  lossDate: string
+}
+
+export type ParseClaimInputResult =
+  | { ok: true; value: ParsedClaimInput }
+  | { ok: false; reason: string }
+
+function isNonEmptyString(value: unknown): value is string {
+  return typeof value === "string" && value.length > 0
+}
+
+/**
+ * Parses an unknown HTTP request body into a `ParsedClaimInput`, or a typed rejection reason.
+ * Never throws - a payload this function cannot make sense of comes back as `{ ok: false }`,
+ * not an exception, so a caller can always turn it into a 400 with a field-level reason
+ * instead of a 500.
+ */
+export function parseClaimInput(body: unknown): ParseClaimInputResult {
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return { ok: false, reason: "request body must be a JSON object" }
+  }
+
+  const record = body as Record<string, unknown>
+
+  if (!isNonEmptyString(record.externalRef)) {
+    return { ok: false, reason: "externalRef must be a non-empty string" }
+  }
+  if (!isNonEmptyString(record.claimantName)) {
+    return { ok: false, reason: "claimantName must be a non-empty string" }
+  }
+  if (!isNonEmptyString(record.lossDate)) {
+    return { ok: false, reason: "lossDate must be a non-empty string" }
+  }
+  if (typeof record.amount !== "number" || !Number.isFinite(record.amount)) {
+    return { ok: false, reason: "amount must be a finite number" }
+  }
+
+  const currency = record.currency === undefined ? "USD" : record.currency
+  if (!isNonEmptyString(currency)) {
+    return { ok: false, reason: "currency must be a non-empty string" }
+  }
+
+  return {
+    ok: true,
+    value: {
+      externalRef: record.externalRef,
+      amount: record.amount,
+      currency,
+      claimantName: record.claimantName,
+      lossDate: record.lossDate,
+    },
+  }
+}
