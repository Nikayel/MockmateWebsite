diff --git a/src/http/compatibility-descriptor.ts b/src/http/compatibility-descriptor.ts
new file mode 100644
index 0000000..b1e2f9f
--- /dev/null
+++ b/src/http/compatibility-descriptor.ts
@@ -0,0 +1,102 @@
+/**
+ * The single source of which query parameters an operation accepts today, which of those are
+ * on a path to sunset, and when. Both the runtime (which stamps `Deprecation`/`Sunset`
+ * headers - see src/http/routes/claims.ts) and the generated OpenAPI document
+ * (src/http/openapi.ts) read from exactly this list. Neither keeps its own copy, so they
+ * cannot say two different things about the same parameter - see MER-104.
+ */
+
+export interface DeprecationInfo {
+  /** Why the parameter is going away, for the generated document's description. */
+  reason: string
+  /** An RFC 3339 date. After this date the parameter may stop being honoured at all. */
+  sunset: string
+}
+
+export interface QueryParameterDescriptor {
+  name: string
+  description: string
+  required: boolean
+  deprecated?: DeprecationInfo
+}
+
+export interface OperationCompatibility {
+  operationId: string
+  method: string
+  /** An OpenAPI-style path template, matching `App.routes()`'s own shape exactly. */
+  path: string
+  queryParameters: QueryParameterDescriptor[]
+}
+
+/**
+ * `offset` is what the claims list took before MER-103 moved paging to a cursor. It is kept
+ * here, deprecated rather than deleted outright, so a caller still sending it does not break
+ * the moment this ships - see the ticket body for why silence isn't the same as backward
+ * compatibility.
+ */
+export const COMPATIBILITY_DESCRIPTOR: OperationCompatibility[] = [
+  {
+    operationId: "listClaims",
+    method: "GET",
+    path: "/claims",
+    queryParameters: [
+      {
+        name: "cursor",
+        description: "An opaque token naming the last claim already seen; omit it for the first page.",
+        required: false,
+      },
+      {
+        name: "limit",
+        description: "How many claims to return, from 1 up to 100.",
+        required: false,
+      },
+      {
+        name: "offset",
+        description: "The zero-based row offset into the tenant's claim list.",
+        required: false,
+        deprecated: {
+          reason: "Superseded by cursor, which does not shift under concurrent writes.",
+          sunset: "2026-11-30",
+        },
+      },
+    ],
+  },
+  {
+    operationId: "createClaim",
+    method: "POST",
+    path: "/claims",
+    queryParameters: [],
+  },
+  {
+    operationId: "getClaim",
+    method: "GET",
+    path: "/claims/{id}",
+    queryParameters: [],
+  },
+  {
+    operationId: "listDocumentsForClaim",
+    method: "GET",
+    path: "/claims/{id}/documents",
+    queryParameters: [],
+  },
+  {
+    operationId: "getHealth",
+    method: "GET",
+    path: "/health",
+    queryParameters: [],
+  },
+]
+
+export interface OperationLocator {
+  method: string
+  path: string
+}
+
+/** Looked up by the exact same `{method, path}` shape `App.routes()` returns, so this can
+ * never quietly disagree with the live route table over whether a path is templated `{id}`
+ * or `:id`. */
+export function findOperationCompatibility(locator: OperationLocator): OperationCompatibility | undefined {
+  return COMPATIBILITY_DESCRIPTOR.find(
+    (operation) => operation.method === locator.method && operation.path === locator.path
+  )
+}
diff --git a/src/http/openapi.ts b/src/http/openapi.ts
new file mode 100644
index 0000000..25aae5c
--- /dev/null
+++ b/src/http/openapi.ts
@@ -0,0 +1,110 @@
+import { COMPATIBILITY_DESCRIPTOR } from "./compatibility-descriptor"
+import type { OperationCompatibility, QueryParameterDescriptor } from "./compatibility-descriptor"
+import type { App } from "./types"
+
+export interface OpenApiParameter {
+  name: string
+  in: "query"
+  required: boolean
+  description: string
+  deprecated?: true
+  schema: { type: "string" }
+}
+
+export interface OpenApiOperation {
+  operationId: string
+  parameters: OpenApiParameter[]
+}
+
+type OpenApiMethod = "get" | "post"
+
+export interface OpenApiDocument {
+  openapi: "3.1.0"
+  info: { title: string; version: string }
+  paths: Record<string, Partial<Record<OpenApiMethod, OpenApiOperation>>>
+}
+
+function toOpenApiParameter(parameter: QueryParameterDescriptor): OpenApiParameter {
+  const description =
+    parameter.deprecated === undefined
+      ? parameter.description
+      : `${parameter.description} Deprecated, sunsetting ${parameter.deprecated.sunset}: ${parameter.deprecated.reason}`
+
+  return {
+    name: parameter.name,
+    in: "query",
+    required: parameter.required,
+    description,
+    ...(parameter.deprecated !== undefined ? { deprecated: true as const } : {}),
+    schema: { type: "string" },
+  }
+}
+
+function toOpenApiOperation(operation: OperationCompatibility): OpenApiOperation {
+  return {
+    operationId: operation.operationId,
+    parameters: operation.queryParameters.map(toOpenApiParameter),
+  }
+}
+
+function toMethodKey(method: string): OpenApiMethod {
+  const lower = method.toLowerCase()
+  if (lower !== "get" && lower !== "post") {
+    throw new Error(`compatibility descriptor names an unsupported HTTP method: ${method}`)
+  }
+  return lower
+}
+
+/**
+ * Builds the OpenAPI document from the exact same compatibility descriptor the runtime reads
+ * to stamp `Deprecation`/`Sunset` headers (src/http/compatibility-descriptor.ts) - there is no
+ * second, hand-maintained copy of which query parameters exist or when they sunset, so the
+ * two cannot drift from each other.
+ */
+export function generateOpenApiDocument(): OpenApiDocument {
+  const paths: OpenApiDocument["paths"] = {}
+  for (const operation of COMPATIBILITY_DESCRIPTOR) {
+    const methodKey = toMethodKey(operation.method)
+    paths[operation.path] = {
+      ...paths[operation.path],
+      [methodKey]: toOpenApiOperation(operation),
+    }
+  }
+  return {
+    openapi: "3.1.0",
+    info: { title: "Meridian Claims API", version: "1" },
+    paths,
+  }
+}
+
+/**
+ * Names every place a registered route and the compatibility descriptor disagree - a route
+ * with nothing documented, or a documented operation with no matching registered route.
+ * Never a frozen snapshot equality check: the document is checked for AGREEMENT with the live
+ * route table, so a route added or removed without updating the descriptor fails loudly here
+ * instead of drifting silently.
+ */
+export function findContractDrift(app: App): string[] {
+  const documented = new Set(
+    COMPATIBILITY_DESCRIPTOR.map((operation) => `${operation.method} ${operation.path}`)
+  )
+  // The document does not describe the route that serves the document itself - the same
+  // convention every OpenAPI document in the wild follows.
+  documented.add("GET /openapi.json")
+  const registered = new Set(app.routes().map((route) => `${route.method} ${route.path}`))
+
+  const drift: string[] = []
+  for (const key of registered) {
+    if (!documented.has(key)) drift.push(`registered route "${key}" is not documented`)
+  }
+  for (const key of documented) {
+    if (!registered.has(key)) drift.push(`documented operation "${key}" is not a registered route`)
+  }
+  return drift
+}
+
+/** Serves the generated document at `/openapi.json` - the same object `generateOpenApiDocument`
+ * returns, never a second hand-maintained copy on disk. */
+export function registerOpenapiRoutes(app: App): void {
+  app.get("/openapi.json", () => ({ statusCode: 200, body: generateOpenApiDocument() }))
+}
