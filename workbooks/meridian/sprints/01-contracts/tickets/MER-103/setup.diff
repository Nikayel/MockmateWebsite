+import type { DbClient } from "../../src/db/client"
+import type { Claim } from "../../src/domain/claim"
+import type { ClaimStatus } from "../../src/domain/claim-status"
+import { INSERT_CLAIM } from "../../src/db/queries"
+
+export interface BuildClaimOptions {
+  id: string
+  tenantId?: string
+  externalRef?: string
+  status?: ClaimStatus
+  amount?: number
+  currency?: string
+  claimantName?: string
+  lossDate?: string
+  createdAt?: string
+}
+
+function buildClaim(options: BuildClaimOptions): Claim {
+  return {
+    id: options.id,
+    tenantId: options.tenantId ?? "ten_northwind",
+    externalRef: options.externalRef ?? `EXT-${options.id}`,
+    status: options.status ?? "submitted",
+    amount: options.amount ?? 100,
+    currency: options.currency ?? "USD",
+    claimantName: options.claimantName ?? "Test Claimant",
+    lossDate: options.lossDate ?? "2026-01-01",
+    createdAt: options.createdAt ?? "2026-01-04T09:12:00.000Z",
+  }
+}
+
+/**
+ * Inserts a claim fixture directly through the same INSERT statement the repository layer
+ * uses, with a caller-controlled `createdAt` - `insertClaim` always stamps `new Date()`
+ * itself, which cannot put two claims on the same millisecond on demand the way a
+ * pagination-tiebreak test needs. Replaces the old `test/fixtures/claims.json`, which nothing
+ * ever read.
+ *
+ * Present from the start of this ticket (not something you write yourself): it is test
+ * scaffolding, not the fix. `src/db/repositories/claims.ts`'s keyset query is the part with
+ * no implementation yet.
+ */
+export async function seedClaim(db: DbClient, options: BuildClaimOptions): Promise<Claim> {
+  const claim = buildClaim(options)
+  await db.query(INSERT_CLAIM, [
+    claim.id,
+    claim.tenantId,
+    claim.externalRef,
+    claim.status,
+    claim.amount,
+    claim.currency,
+    claim.claimantName,
+    claim.lossDate,
+    claim.createdAt,
+  ])
+  return claim
+}
