+const DEFAULT_LIMIT = 20
+const MAX_LIMIT = 100
+
+export type ParseLimitResult = { ok: true; limit: number } | { ok: false }
+
+/** The page size is bounded: an absurd or unbounded value is rejected outright, never
+ * silently clamped down to something the caller did not ask for. */
+export function parseLimit(raw: string | null): ParseLimitResult {
+  if (raw === null) return { ok: true, limit: DEFAULT_LIMIT }
+  const limit = Number(raw)
+  if (!Number.isInteger(limit) || limit < 1 || limit > MAX_LIMIT) {
+    return { ok: false }
+  }
+  return { ok: true, limit }
+}
+
+export type DecodedCursor =
+  | { kind: "none" }
+  | { kind: "valid"; cursor: ClaimsCursor }
+  | { kind: "invalid" }
+
+/** A cursor names the exact `(createdAt, id)` tiebreak position the caller last saw. It is
+ * never parsed as a bare timestamp - a cursor with only half the tiebreak is treated as
+ * invalid, not silently accepted with the missing half defaulted to something. */
+export function decodeClaimsCursor(raw: string | null): DecodedCursor {
+  if (raw === null) return { kind: "none" }
+  try {
+    const parsed: unknown = JSON.parse(raw)
+    if (
+      typeof parsed === "object" &&
+      parsed !== null &&
+      typeof (parsed as Record<string, unknown>).createdAt === "string" &&
+      typeof (parsed as Record<string, unknown>).id === "string"
+    ) {
+      const { createdAt, id } = parsed as Record<string, unknown>
+      return { kind: "valid", cursor: { createdAt: createdAt as string, id: id as string } }
+    }
+    return { kind: "invalid" }
+  } catch {
+    return { kind: "invalid" }
+  }
+}
+
+function encodeClaimsCursor(cursor: ClaimsCursor): string {
+  return JSON.stringify(cursor)
+}
