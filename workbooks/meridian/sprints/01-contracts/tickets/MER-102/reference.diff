--- /dev/null
+++ b/src/http/error-codes.ts
@@ -0,0 +1,13 @@
+/**
+ * Stable, machine-readable error codes a partner's retry logic can branch on. A code never
+ * changes once shipped, even if the human-readable message next to it gets reworded - add a
+ * new one here before using it anywhere else, this is the one place they are all named.
+ */
+export const ERROR_CODES = {
+  VALIDATION_ERROR: "VALIDATION_ERROR",
+  MISSING_TENANT: "MISSING_TENANT",
+  NOT_FOUND: "NOT_FOUND",
+  INTERNAL_ERROR: "INTERNAL_ERROR",
+} as const
+
+export type ErrorCode = (typeof ERROR_CODES)[keyof typeof ERROR_CODES]
diff --git a/src/http/errors.ts b/src/http/errors.ts
index 1ae8ad9..c815571 100644
--- a/src/http/errors.ts
+++ b/src/http/errors.ts
@@ -1,10 +1,54 @@
+import type { ErrorCode } from "./error-codes"
+import { ERROR_CODES } from "./error-codes"
 import type { HandlerResponse } from "./types"
 
-// Each helper returns its own response shape.
-export function notFound(message: string): HandlerResponse {
-  return { statusCode: 404, body: { message } }
+/** The one shape every error response takes, on every path - including the ones the
+ * framework generates itself (an unmatched route, an uncaught exception). A partner can
+ * always read `error.code`, never has to guess whether this particular failure looks
+ * different from the last one. */
+export interface ErrorResponseBody {
+  error: {
+    code: ErrorCode
+    message: string
+    correlationId: string
+  }
 }
 
-export function badRequest(message: string): HandlerResponse {
-  return { statusCode: 400, body: { message } }
+interface ErrorOptions {
+  message: string
+  correlationId: string
+}
+
+function errorEnvelope(statusCode: number, code: ErrorCode, options: ErrorOptions): HandlerResponse {
+  return {
+    statusCode,
+    body: { error: { code, message: options.message, correlationId: options.correlationId } },
+  }
+}
+
+export function badRequest(options: ErrorOptions): HandlerResponse {
+  return errorEnvelope(400, ERROR_CODES.VALIDATION_ERROR, options)
+}
+
+/** A distinct code from `VALIDATION_ERROR` on purpose - a partner whose integration forgot
+ * the tenant header entirely is a different failure than one whose claim payload is wrong,
+ * and their retry logic should be able to tell the two apart. */
+export function missingTenant(options: ErrorOptions): HandlerResponse {
+  return errorEnvelope(400, ERROR_CODES.MISSING_TENANT, options)
+}
+
+export function notFound(options: ErrorOptions): HandlerResponse {
+  return errorEnvelope(404, ERROR_CODES.NOT_FOUND, options)
+}
+
+/**
+ * Takes no error detail as an argument, on purpose - there is structurally nothing here for
+ * a stack trace or a database error string to ride along on. The correlation id is what lets
+ * support find the real detail in the server's own log line instead.
+ */
+export function internalError(options: { correlationId: string }): HandlerResponse {
+  return errorEnvelope(500, ERROR_CODES.INTERNAL_ERROR, {
+    message: "Something went wrong on our end. Contact support with this correlation id.",
+    correlationId: options.correlationId,
+  })
 }
