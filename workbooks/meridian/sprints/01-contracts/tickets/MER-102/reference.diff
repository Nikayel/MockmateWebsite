+import { generateId } from "../util/ids"
 import type { HandlerRequest } from "./types"
 
+/** Thrown by `requireTenantId` - a distinct type so `src/http/server.ts` can tell "the caller
+ * forgot the tenant header" apart from every other exception a handler might raise, and
+ * answer with a 400 in its own error code instead of a generic 500. */
+export class MissingTenantError extends Error {
+  constructor() {
+    super("Missing x-tenant-id header")
+    this.name = "MissingTenantError"
+  }
+}
+
 /**
  * There is no auth system in front of this API yet - every request carries its tenant in a
  * header, and we trust whoever is calling us to set it correctly.
@@ -7,7 +18,14 @@ import type { HandlerRequest } from "./types"
 export function requireTenantId(req: HandlerRequest): string {
   const tenantId = req.headers["x-tenant-id"]
   if (!tenantId) {
-    throw new Error("Missing x-tenant-id header")
+    throw new MissingTenantError()
   }
   return tenantId
 }
+
+/** A caller-supplied `x-correlation-id` is echoed back verbatim, so a partner who already
+ * tags their own requests can trace one through our logs by an id they chose themselves.
+ * Otherwise one is generated, so every request still gets exactly one. */
+export function getCorrelationId(headers: Record<string, string>): string {
+  return headers["x-correlation-id"] || generateId("req")
+}
