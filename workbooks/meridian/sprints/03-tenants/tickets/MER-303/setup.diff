+
+export interface ReleaseTimingCheckInput {
+  firstTenantId: string
+  secondTenantId: string
+}
+
+export interface ReleaseTimingCheckResult {
+  /** The second connection's tenant id read the instant acquire() returns it. */
+  immediatelyAfterReacquire: string | null
+  /** The same connection's tenant id read after yielding to the microtask queue once - the
+   * same kind of yield a real `await connection.query(...)` inside the second caller's own
+   * request would cause. */
+  afterYieldingOnce: string | null
+}
+
+/**
+ * A pool of size one: acquires `firstTenantId`, releases it, immediately acquires
+ * `secondTenantId` with no await in between, then reports what the second connection's tenant
+ * id reads as right away and after one microtask-queue yield. A pool whose release() clears the
+ * tag synchronously reports the same value both times; one that defers the reset to a listener
+ * can report `secondTenantId` immediately and then something else once the deferred reset
+ * finally runs - corrupting a request that already believed it was safely holding its own
+ * connection.
+ */
+export async function checkReleaseTimingSurvivesReacquire(
+  input: ReleaseTimingCheckInput
+): Promise<ReleaseTimingCheckResult> {
+  const pool = createConnectionPool(createMemoryDbForCheck(), 1)
+  const first = pool.acquire(input.firstTenantId)
+  pool.release(first)
+  const second = pool.acquire(input.secondTenantId)
+  const immediatelyAfterReacquire = second.tenantId
+  await Promise.resolve()
+  const afterYieldingOnce = second.tenantId
+  return { immediatelyAfterReacquire, afterYieldingOnce }
+}
+
+/** A minimal, self-contained `DbClient` this module's own diagnostic check can run against -
+ * it never actually queries anything, so it does not need to depend on `./memory-db` (which
+ * depends on `./queries`, which has nothing to do with connection pooling). */
+function createMemoryDbForCheck(): DbClient {
+  return {
+    query: async () => ({ rows: [] }),
+  }
+}
