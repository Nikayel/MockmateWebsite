diff --git a/migrations/0010_row_level_security.sql b/migrations/0010_row_level_security.sql
new file mode 100644
index 0000000..95d5d6e
--- /dev/null
+++ b/migrations/0010_row_level_security.sql
@@ -0,0 +1,42 @@
+-- MER-302: tenant isolation moves out of the WHERE clauses application code has to remember to
+-- write and into Postgres itself. ENABLE alone is not enough on its own: it exempts the
+-- table's own owner from every policy on it, and the role the application connects as is the
+-- table's owner (there is no separate migration-runner identity in this schema yet) - without
+-- FORCE, a perfectly-written policy would still let every row through for that connection.
+
+alter table claims enable row level security;
+alter table claims force row level security;
+
+-- USING governs which existing rows are visible (SELECT/UPDATE/DELETE); WITH CHECK governs
+-- which rows a write is allowed to leave behind (INSERT, and the post-image of an UPDATE) -
+-- both read the same session-scoped setting, so a caller cannot read one tenant's claims while
+-- writing under another's, and cannot move a row it does own out to a tenant it does not.
+create policy claims_tenant_isolation on claims
+  using (tenant_id = current_setting('app.tenant_id', true))
+  with check (tenant_id = current_setting('app.tenant_id', true));
+
+alter table documents enable row level security;
+alter table documents force row level security;
+
+-- Documents carry no tenant column of their own (see migrations/0001_init.sql - the
+-- extraction worker only ever has a claim id off a queue message, no tenant in scope). Visibility
+-- is derived from the parent claim, in the database, via a correlated EXISTS against claims'
+-- own already-tenant-scoped rows - never from a tenant key copied onto the document row, which
+-- would be a second source of truth the extraction worker could set wrong. Applied to both
+-- USING and WITH CHECK, so a document cannot be read across the boundary, and cannot be
+-- created pointing at a claim it has no business referencing in the first place.
+create policy documents_tenant_isolation_via_claim on documents
+  using (
+    exists (
+      select 1 from claims
+      where claims.id = documents.claim_id
+        and claims.tenant_id = current_setting('app.tenant_id', true)
+    )
+  )
+  with check (
+    exists (
+      select 1 from claims
+      where claims.id = documents.claim_id
+        and claims.tenant_id = current_setting('app.tenant_id', true)
+    )
+  );
