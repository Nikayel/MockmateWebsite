diff --git a/src/http/routes/documents.ts b/src/http/routes/documents.ts
index 02fe042..43a4aac 100644
--- a/src/http/routes/documents.ts
+++ b/src/http/routes/documents.ts
@@ -1,14 +1,30 @@
 import type { DbClient } from "../../db/client"
+import { getClaimById } from "../../db/repositories/claims"
 import { getDocumentsForClaim } from "../../db/repositories/documents"
+import { notFound } from "../errors"
+import { requireTenantId } from "../request-context"
 import type { App } from "../types"
 
 export interface DocumentRouteDeps {
   db: DbClient
 }
 
-/** Does not check which tenant the caller belongs to. */
+/**
+ * MER-302: document visibility is derived from the parent claim - see
+ * migrations/0010_row_level_security.sql, which is what actually enforces this once the
+ * application connects through Postgres. This app-level check is the same rule stated again at
+ * the boundary: today's `DbClient` has no real Postgres connection behind it yet (see
+ * src/db/memory-db.ts), so this route cannot yet rely on the database to refuse on its own -
+ * it 404s a claim the requesting tenant cannot see instead of ever calling
+ * `getDocumentsForClaim` for it.
+ */
 export function registerDocumentRoutes(app: App, deps: DocumentRouteDeps): void {
   app.get("/claims/:id/documents", async (req) => {
+    const tenantId = requireTenantId(req)
+    const claim = await getClaimById(deps.db, tenantId, req.params.id)
+    if (!claim) {
+      return notFound({ message: `claim ${req.params.id} not found`, correlationId: req.correlationId })
+    }
     const documents = await getDocumentsForClaim(deps.db, req.params.id)
     return { statusCode: 200, body: { documents } }
   })
