index 0000000..229243f
--- /dev/null
+++ b/src/db/tenant-context.ts
@@ -0,0 +1,76 @@
+import type { DbClient, QueryResult } from "./client"
+
+/**
+ * A connection checked out of the pool for exactly one tenant's request. There is no real
+ * Postgres connection here yet - `query` delegates straight through to the same underlying
+ * `DbClient` every connection in the pool shares - but `tenantId` is mutable and the object
+ * itself is REUSED across checkouts, the same way a real pooled connection is one physical
+ * object handed to many callers over its lifetime. A repository function reads `tenantId` off
+ * whatever connection it was given instead of a tenant id passed as a loose parameter. A later
+ * ticket in this sprint moves tenant scoping out of this object entirely and into Postgres
+ * itself.
+ */
+export interface PooledConnection {
+  tenantId: string | null
+  query<T = unknown>(sql: string, params?: unknown[]): Promise<QueryResult<T>>
+}
+
+export interface ConnectionPool {
+  acquire(tenantId: string): PooledConnection
+  release(connection: PooledConnection): void
+}
+
+/**
+ * `size` fixed connection objects, handed out round-robin and REUSED, never recreated - a pool
+ * of size one always hands the next `acquire()` the exact same object the last caller had.
+ * That is what makes it possible to prove a released connection's tenant tag cannot survive
+ * into the next caller: with only one object, "the next caller's connection" and "the
+ * connection whoever just released it was holding" are the same object, not merely similar.
+ */
+export function createConnectionPool(db: DbClient, size: number): ConnectionPool {
+  if (size < 1) throw new Error("pool size must be at least 1")
+  const connections: PooledConnection[] = Array.from({ length: size }, () => ({
+    tenantId: null,
+    query: (sql, params) => db.query(sql, params),
+  }))
+  let nextIndex = 0
+
+  return {
+    acquire(tenantId) {
+      const connection = connections[nextIndex]
+      nextIndex = (nextIndex + 1) % connections.length
+      connection.tenantId = tenantId
+      return connection
+    },
+
+    /**
+     * Clears the connection's tenant tag synchronously, inline, before `release()` returns -
+     * never scheduled onto a listener, an event emitter, or a later tick. That is the entire
+     * fix SUP-2291 needed: nothing runs between "released" and "cleared" for a later callback
+     * to race against, so the very next `acquire()` (which stamps its own tenant id
+     * immediately, synchronously, in the same call) can never observe - or be clobbered by - a
+     * reset left pending from the connection's previous tenant.
+     */
+    release(connection) {
+      connection.tenantId = null
+    },
+  }
+}
+
+/**
+ * Runs `fn` against a connection acquired for `tenantId`, releasing it when `fn` settles either
+ * way. Scopes tenant identity to the lifetime of this one call - the caller never threads a raw
+ * tenantId string into whatever repository function it calls next; the connection carries it.
+ */
+export async function withTenant<T>(
+  pool: ConnectionPool,
+  tenantId: string,
+  fn: (connection: PooledConnection) => Promise<T>
+): Promise<T> {
+  const connection = pool.acquire(tenantId)
+  try {
+    return await fn(connection)
+  } finally {
+    pool.release(connection)
+  }
+}
