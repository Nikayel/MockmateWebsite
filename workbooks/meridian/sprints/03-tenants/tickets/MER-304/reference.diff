+-- MER-304: the claims list endpoint's own query and its composite index
+-- (migrations/0004_claims_created_at_id_idx.sql) are untouched by this ticket - the regression
+-- is in what that endpoint does next, fetching every returned claim's documents. That fetch is
+-- now one statement for the whole page instead of one per claim (see
+-- src/db/repositories/documents.ts's `getDocumentsForClaims`), and this index is what that one
+-- statement needs: column order matches its own ORDER BY exactly, so rows for the same claim
+-- come back together and in a stable order without a separate sort step.
+create index documents_claim_id_created_at_idx on documents(claim_id, created_at);
