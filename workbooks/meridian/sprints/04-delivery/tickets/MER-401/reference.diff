+-- MER-401: one row per (tenant, Idempotency-Key) pair actually executed, so a retried POST can
+-- replay its original response instead of running the handler again. See src/http/idempotency.ts.
+create table idempotency_keys (
+  tenant_id text not null,
+  idempotency_key text not null,
+  request_fingerprint text not null,
+  response_status integer not null,
+  response_body text not null,
+  created_at timestamptz not null default now(),
+  primary key (tenant_id, idempotency_key)
+);
+
+comment on table idempotency_keys is
+  'One row per (tenant, Idempotency-Key) pair. request_fingerprint is a canonical hash over
+   method + path + body (src/util/canonical-json.ts), so a retry with the same key and the same
+   logical body - regardless of key order in the JSON the client sent - replays
+   response_status/response_body verbatim. A retry with the same key and a different fingerprint
+   is a 409, never silently reprocessed and never silently accepted as the original.';
