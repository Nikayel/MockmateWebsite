@@ -0,0 +1,71 @@
+import type { DbClient } from "../client"
+import { FIND_IDEMPOTENCY_KEY, INSERT_IDEMPOTENCY_KEY } from "../queries"
+
+export interface IdempotencyKeyRecord {
+  tenantId: string
+  idempotencyKey: string
+  requestFingerprint: string
+  responseStatus: number
+  responseBody: string
+  createdAt: string
+}
+
+interface IdempotencyKeyRow {
+  tenant_id: string
+  idempotency_key: string
+  request_fingerprint: string
+  response_status: number
+  response_body: string
+  created_at: string
+}
+
+function toIdempotencyKeyRecord(row: IdempotencyKeyRow): IdempotencyKeyRecord {
+  return {
+    tenantId: row.tenant_id,
+    idempotencyKey: row.idempotency_key,
+    requestFingerprint: row.request_fingerprint,
+    responseStatus: row.response_status,
+    responseBody: row.response_body,
+    createdAt: row.created_at,
+  }
+}
+
+export interface InsertIdempotencyKeyInput {
+  tenantId: string
+  idempotencyKey: string
+  requestFingerprint: string
+  responseStatus: number
+  responseBody: string
+}
+
+/** Persists the one response a (tenant, key) pair produced. Scoped to the tenant in the
+ * primary key itself (migrations/0013_idempotency_keys.sql) - one tenant's key can never
+ * collide with or replay another tenant's, because there is no row a cross-tenant lookup could
+ * even find. */
+export async function insertIdempotencyKey(
+  db: DbClient,
+  input: InsertIdempotencyKeyInput
+): Promise<IdempotencyKeyRecord> {
+  const createdAt = new Date().toISOString()
+  const { rows } = await db.query<IdempotencyKeyRow>(INSERT_IDEMPOTENCY_KEY, [
+    input.tenantId,
+    input.idempotencyKey,
+    input.requestFingerprint,
+    input.responseStatus,
+    input.responseBody,
+    createdAt,
+  ])
+  return toIdempotencyKeyRecord(rows[0])
+}
+
+export async function findIdempotencyKey(
+  db: DbClient,
+  tenantId: string,
+  idempotencyKey: string
+): Promise<IdempotencyKeyRecord | null> {
+  const { rows } = await db.query<IdempotencyKeyRow>(FIND_IDEMPOTENCY_KEY, [
+    tenantId,
+    idempotencyKey,
+  ])
+  return rows[0] ? toIdempotencyKeyRecord(rows[0]) : null
+}
