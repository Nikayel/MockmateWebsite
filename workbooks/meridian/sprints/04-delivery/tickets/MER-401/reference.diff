diff --git a/src/http/idempotency.ts b/src/http/idempotency.ts
new file mode 100644
index 0000000..e343e6c
--- /dev/null
+++ b/src/http/idempotency.ts
@@ -0,0 +1,84 @@
+import type { DbClient } from "../db/client"
+import { findIdempotencyKey, insertIdempotencyKey } from "../db/repositories/idempotency-keys"
+import type { JsonValue } from "../util/canonical-json"
+import { hashCanonical } from "../util/canonical-json"
+
+export interface IdempotentRequestIdentity {
+  tenantId: string
+  idempotencyKey: string
+  method: string
+  path: string
+  body: unknown
+}
+
+/**
+ * The fingerprint an idempotency key is checked against: method, path and body together,
+ * canonically encoded - see MER-203's src/util/canonical-json.ts. Reuses that encoder rather
+ * than hashing whatever `JSON.stringify` happens to produce, so a retried request whose client
+ * serialized the exact same logical body with its keys in a different order still fingerprints
+ * identically, instead of reading as a materially different request. Path is part of the
+ * fingerprint, not just the body, so the same key replayed against a different claim's
+ * endpoint is never mistaken for a replay of this one.
+ */
+export function fingerprintIdempotentRequest(
+  identity: Pick<IdempotentRequestIdentity, "method" | "path" | "body">
+): string {
+  return hashCanonical({
+    method: identity.method,
+    path: identity.path,
+    body: (identity.body ?? null) as JsonValue,
+  })
+}
+
+export type IdempotencyCheckResult =
+  | { kind: "fresh" }
+  | { kind: "replay"; statusCode: number; body: unknown }
+  | { kind: "conflict" }
+
+/**
+ * Looks up whatever this (tenant, key) pair already recorded, if anything. `fresh` means the
+ * caller should actually do the work; `replay` means hand back exactly what was recorded last
+ * time, verbatim, with no side effect re-run; `conflict` means the same key arrived with a
+ * fingerprint that does not match what was recorded, and must be rejected rather than silently
+ * reprocessed or silently accepted as the original.
+ */
+export async function checkIdempotency(
+  db: DbClient,
+  identity: IdempotentRequestIdentity
+): Promise<IdempotencyCheckResult> {
+  const existing = await findIdempotencyKey(db, identity.tenantId, identity.idempotencyKey)
+  if (!existing) return { kind: "fresh" }
+
+  const fingerprint = fingerprintIdempotentRequest(identity)
+  if (existing.requestFingerprint !== fingerprint) return { kind: "conflict" }
+
+  return {
+    kind: "replay",
+    statusCode: existing.responseStatus,
+    body: JSON.parse(existing.responseBody) as unknown,
+  }
+}
+
+export interface RecordIdempotentResponseInput extends IdempotentRequestIdentity {
+  statusCode: number
+  responseBody: unknown
+}
+
+/**
+ * Persists the one response this (tenant, key) pair produced, so a later request carrying the
+ * same key replays it instead of running the handler again. Call once, after the real work has
+ * actually succeeded - never speculatively beforehand, and never for a request with no
+ * idempotency key at all.
+ */
+export async function recordIdempotentResponse(
+  db: DbClient,
+  input: RecordIdempotentResponseInput
+): Promise<void> {
+  await insertIdempotencyKey(db, {
+    tenantId: input.tenantId,
+    idempotencyKey: input.idempotencyKey,
+    requestFingerprint: fingerprintIdempotentRequest(input),
+    responseStatus: input.statusCode,
+    responseBody: JSON.stringify(input.responseBody),
+  })
+}
diff --git a/src/http/routes/payment-authorizations.ts b/src/http/routes/payment-authorizations.ts
new file mode 100644
index 0000000..ea462d0
--- /dev/null
+++ b/src/http/routes/payment-authorizations.ts
@@ -0,0 +1,134 @@
+import type { DbClient } from "../../db/client"
+import { getClaimById } from "../../db/repositories/claims"
+import type { Claim } from "../../domain/claim"
+import { toWireAmountV1 } from "../../money/money"
+import type { Outbox } from "../../queue/outbox"
+import { badRequest, idempotencyKeyConflict, idempotencyKeyRequired, notFound } from "../errors"
+import { checkIdempotency, recordIdempotentResponse } from "../idempotency"
+import { requireTenantId } from "../request-context"
+import type { App } from "../types"
+
+export interface PaymentAuthorizationRouteDeps {
+  db: DbClient
+  outbox: Outbox
+}
+
+export interface AuthorizePaymentInput {
+  approvedBy: string
+  memo: string | null
+}
+
+export type ParseAuthorizePaymentInputResult =
+  | { ok: true; value: AuthorizePaymentInput }
+  | { ok: false; reason: string }
+
+/** What an ops tool has to send to authorize a claim's payment, checked field by field before
+ * anything downstream trusts it - the same discipline src/http/parsers/claim-input.ts uses for
+ * claim intake. */
+export function parseAuthorizePaymentInput(body: unknown): ParseAuthorizePaymentInputResult {
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return { ok: false, reason: "request body must be a JSON object" }
+  }
+  const record = body as Record<string, unknown>
+  if (typeof record.approvedBy !== "string" || record.approvedBy.length === 0) {
+    return { ok: false, reason: "approvedBy must be a non-empty string" }
+  }
+  if (record.memo !== undefined && typeof record.memo !== "string") {
+    return { ok: false, reason: "memo must be a string when present" }
+  }
+  return { ok: true, value: { approvedBy: record.approvedBy, memo: record.memo ?? null } }
+}
+
+/** The exact path this endpoint is served at, for a given claim - also the path half of the
+ * idempotency fingerprint (src/http/idempotency.ts), so the same Idempotency-Key reused against
+ * a different claim can never be mistaken for a replay of this one. */
+export function paymentAuthorizationPath(claimId: string): string {
+  return `/claims/${claimId}/payment-authorizations`
+}
+
+export interface PaymentAuthorizationResponseBody {
+  claimId: string
+  externalRef: string
+  amount: number
+  currency: string
+  approvedBy: string
+  authorizedAt: string
+}
+
+function buildResponseBody(
+  claim: Claim,
+  approvedBy: string,
+  authorizedAt: string
+): PaymentAuthorizationResponseBody {
+  return {
+    claimId: claim.id,
+    externalRef: claim.externalRef,
+    amount: toWireAmountV1(claim.money),
+    currency: claim.money.currency,
+    approvedBy,
+    authorizedAt,
+  }
+}
+
+/**
+ * Authorizes a claim's payment and enqueues the webhook that tells its tenant so. Idempotent
+ * under a client retry (MER-401): the same Idempotency-Key with the same body gets back the
+ * exact response the first attempt produced, with no second webhook enqueued; the same key with
+ * a materially different body is rejected outright rather than silently reprocessed or silently
+ * accepted as the original. See src/http/idempotency.ts for the fingerprint and replay
+ * mechanics this handler is built on.
+ */
+export function registerPaymentAuthorizationRoutes(
+  app: App,
+  deps: PaymentAuthorizationRouteDeps
+): void {
+  app.post("/claims/:id/payment-authorizations", async (req) => {
+    const tenantId = requireTenantId(req)
+    const claim = await getClaimById(deps.db, tenantId, req.params.id)
+    if (!claim) {
+      return notFound({
+        message: `claim ${req.params.id} not found`,
+        correlationId: req.correlationId,
+      })
+    }
+
+    const idempotencyKey = req.headers["idempotency-key"]
+    if (!idempotencyKey) {
+      return idempotencyKeyRequired({
+        message: "Idempotency-Key header is required to authorize a payment",
+        correlationId: req.correlationId,
+      })
+    }
+
+    const parsed = parseAuthorizePaymentInput(req.body)
+    if (!parsed.ok) {
+      return badRequest({ message: parsed.reason, correlationId: req.correlationId })
+    }
+
+    const identity = {
+      tenantId,
+      idempotencyKey,
+      method: "POST",
+      path: paymentAuthorizationPath(claim.id),
+      body: req.body,
+    }
+
+    const check = await checkIdempotency(deps.db, identity)
+    if (check.kind === "conflict") {
+      return idempotencyKeyConflict({
+        message: "This idempotency key was already used with a different request body",
+        correlationId: req.correlationId,
+      })
+    }
+    if (check.kind === "replay") {
+      return { statusCode: check.statusCode, body: check.body }
+    }
+
+    deps.outbox.enqueue({ type: "claim.processed", tenantId, claimId: claim.id })
+
+    const responseBody = buildResponseBody(claim, parsed.value.approvedBy, new Date().toISOString())
+    await recordIdempotentResponse(deps.db, { ...identity, statusCode: 201, responseBody })
+
+    return { statusCode: 201, body: responseBody }
+  })
+}
