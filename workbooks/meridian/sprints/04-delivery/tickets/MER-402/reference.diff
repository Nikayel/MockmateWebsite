new file mode 100644
index 0000000..7c35327
--- /dev/null
+++ b/migrations/0014_outbox.sql
@@ -0,0 +1,29 @@
+-- MER-402: a durable outbox table, replacing the in-process array src/queue/outbox.ts used to
+-- stand in for one. A row here and the business row it describes are always written inside the
+-- same transaction (see src/http/routes/claims.ts, src/http/routes/payment-authorizations.ts),
+-- so a crash between "claim written" and "event queued" is impossible by construction.
+--
+-- Drained with a lease rather than deleted-on-read: `leased_by`/`leased_until` model Postgres's
+-- `FOR UPDATE SKIP LOCKED` (see src/db/queries.ts's CLAIM_OUTBOX_BATCH) - two workers claiming
+-- from the same backlog never receive the same row, and a worker that crashes mid-delivery
+-- leaves its claimed rows to be reclaimed once their lease expires, rather than stuck forever.
+create table outbox_entries (
+  id text primary key,
+  tenant_id text not null,
+  claim_id text not null,
+  event_type text not null,
+  status text not null default 'pending',
+  leased_by text,
+  leased_until timestamptz,
+  created_at timestamptz not null default now(),
+  delivered_at timestamptz
+);
+
+comment on table outbox_entries is
+  'MER-402: the durable outbox. A row and the business write it describes are always committed
+   in the same transaction. status is one of pending, leased, delivered. leased_until is null
+   until a worker claims the row; a row whose lease has expired is eligible to be reclaimed by a
+   different worker exactly as if it were still pending. See src/db/repositories/outbox.ts.';
+
+create index outbox_entries_claimable_idx on outbox_entries (created_at)
+  where status = 'pending' or status = 'leased';
