index 0000000..a8b052d
--- /dev/null
+++ b/test/support/failing-query-db.ts
@@ -0,0 +1,21 @@
+import type { DbClient } from "../../src/db/client"
+
+/**
+ * Wraps `client` so any call whose SQL text is exactly `failingSql` throws instead of running -
+ * everything else passes straight through, including a nested `transaction()` call, which stays
+ * wrapped so the failure still fires no matter how deep inside the transaction it is issued. Used
+ * to prove MER-402's transactional-outbox guarantee: a specific write inside a transaction
+ * failing must roll back everything else the transaction did, not just that one write.
+ */
+export function createFailingQueryDb(client: DbClient, failingSql: string): DbClient {
+  const wrap = (target: DbClient): DbClient => ({
+    query: (sql, params) => {
+      if (sql === failingSql) {
+        throw new Error(`simulated failure for: ${failingSql}`)
+      }
+      return target.query(sql, params)
+    },
+    transaction: (fn) => target.transaction((tx) => fn(wrap(tx))),
+  })
+  return wrap(client)
+}
