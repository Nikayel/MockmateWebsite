+  "UPDATE outbox_entries SET status = 'leased', leased_by = $1, leased_until = $2" +
+  " WHERE id IN (" +
+  "SELECT id FROM outbox_entries" +
+  " WHERE status = 'pending' OR (status = 'leased' AND leased_until < now())" +
+  " ORDER BY created_at LIMIT $3 FOR UPDATE SKIP LOCKED" +
+  ") RETURNING *"
+
+export const MARK_OUTBOX_ENTRY_DELIVERED =
+  "UPDATE outbox_entries SET status = 'delivered', delivered_at = $2 WHERE id = $1 RETURNING *"
