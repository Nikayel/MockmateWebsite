+/** MER-402: always issued on whatever client the caller is holding - the same connection as
+ * whatever business write it accompanies, so wrapping both in one `db.transaction(...)` call
+ * (src/db/client.ts) commits or rolls back the two of them together. */
+export const INSERT_OUTBOX_ENTRY =
+  "INSERT INTO outbox_entries (id, tenant_id, claim_id, event_type, status, created_at) VALUES ($1, $2, $3, $4, 'pending', $5) RETURNING *"
+
+/**
+ * The real shape a Postgres-backed drain would run: `FOR UPDATE SKIP LOCKED` so two workers
+ * racing this same statement never both lock the same rows, `leased_until < now()` so a lease
+ * left by a crashed worker is exactly as claimable as a row that was never leased at all, and
+ * `LIMIT $3` so one drain never claims the entire backlog. See src/db/repositories/outbox.ts.
+ */
