diff --git a/src/db/repositories/outbox.ts b/src/db/repositories/outbox.ts
new file mode 100644
index 0000000..35c7658
--- /dev/null
+++ b/src/db/repositories/outbox.ts
@@ -0,0 +1,106 @@
+import type { DbClient } from "../client"
+import type { DomainEvent } from "../../queue/events"
+import { generateId } from "../../util/ids"
+import { CLAIM_OUTBOX_BATCH, INSERT_OUTBOX_ENTRY, MARK_OUTBOX_ENTRY_DELIVERED } from "../queries"
+
+export type OutboxEntryStatus = "pending" | "leased" | "delivered"
+
+/** A durable outbox row (migrations/0014_outbox.sql) - MER-402's replacement for the in-process
+ * array src/queue/outbox.ts used to stand in for one. */
+export interface OutboxEntryRecord {
+  id: string
+  tenantId: string
+  claimId: string
+  eventType: string
+  status: OutboxEntryStatus
+  leasedBy: string | null
+  leasedUntil: string | null
+  createdAt: string
+  deliveredAt: string | null
+}
+
+interface OutboxEntryRow {
+  id: string
+  tenant_id: string
+  claim_id: string
+  event_type: string
+  status: OutboxEntryStatus
+  leased_by: string | null
+  leased_until: string | null
+  created_at: string
+  delivered_at: string | null
+}
+
+function toOutboxEntryRecord(row: OutboxEntryRow): OutboxEntryRecord {
+  return {
+    id: row.id,
+    tenantId: row.tenant_id,
+    claimId: row.claim_id,
+    eventType: row.event_type,
+    status: row.status,
+    leasedBy: row.leased_by,
+    leasedUntil: row.leased_until,
+    createdAt: row.created_at,
+    deliveredAt: row.delivered_at,
+  }
+}
+
+/**
+ * Inserts one outbox row for `event`. Issued on whatever `db` the caller hands in - pass a
+ * transaction-scoped client (src/db/client.ts's `transaction`) to commit this together with the
+ * business row it describes, which is the whole point of MER-402: a crash between the two must
+ * be impossible, not just unlikely.
+ */
+export async function insertOutboxEntry(db: DbClient, event: DomainEvent): Promise<OutboxEntryRecord> {
+  const id = generateId("obx")
+  const createdAt = new Date().toISOString()
+  const { rows } = await db.query<OutboxEntryRow>(INSERT_OUTBOX_ENTRY, [
+    id,
+    event.tenantId,
+    event.claimId,
+    event.type,
+    createdAt,
+  ])
+  return toOutboxEntryRecord(rows[0])
+}
+
+export interface ClaimOutboxBatchInput {
+  /** Identifies whoever is claiming this batch - stamped onto every row it claims, purely for
+   * observability (which worker is holding a lease). Never read back to decide what a worker is
+   * allowed to claim; a fresh worker with a brand new id can still reclaim a row an old, dead
+   * worker's lease expired on. */
+  workerId: string
+  leaseDurationMs: number
+  limit: number
+}
+
+/**
+ * Claims up to `limit` rows that are either pending or whose previous lease has expired,
+ * marking them leased to `workerId` until now + `leaseDurationMs` - see CLAIM_OUTBOX_BATCH in
+ * src/db/queries.ts for the `FOR UPDATE SKIP LOCKED` statement this models. Two workers calling
+ * this against the same backlog never both receive the same row: a real Postgres `SKIP LOCKED`
+ * guarantees it across processes, and src/db/memory-db.ts's handler guarantees the equivalent
+ * for this in-memory stand-in by reading and marking eligible rows in one synchronous stretch
+ * with no `await` in between the two calls this codebase's tests make to prove it.
+ */
+export async function claimOutboxBatch(
+  db: DbClient,
+  input: ClaimOutboxBatchInput
+): Promise<OutboxEntryRecord[]> {
+  const leasedUntil = new Date(Date.now() + input.leaseDurationMs).toISOString()
+  const { rows } = await db.query<OutboxEntryRow>(CLAIM_OUTBOX_BATCH, [
+    input.workerId,
+    leasedUntil,
+    input.limit,
+  ])
+  return rows.map(toOutboxEntryRecord)
+}
+
+/** Marks one claimed entry delivered. Never called for an entry whose handler threw - an entry
+ * that fails delivery stays leased until its lease naturally expires, so a different worker (or
+ * the same one, later) picks it back up exactly as if it had never been claimed, rather than
+ * this codebase inventing a separate "release early" path a crashed worker could never reach
+ * anyway. */
+export async function markOutboxEntryDelivered(db: DbClient, id: string): Promise<void> {
+  await db.query(MARK_OUTBOX_ENTRY_DELIVERED, [id, new Date().toISOString()])
+}
