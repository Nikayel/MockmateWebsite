@@ -0,0 +1,12 @@
+-- MER-405: a claim's own outbox entries must always be delivered in the order they were
+-- produced, even across a retry - so claiming only ever takes the EARLIEST undelivered entry
+-- per claim_id (the head of that claim's own lane), never a later one jumping ahead of a sibling
+-- still waiting on its own backoff. This index matches that per-claim ordering scan exactly, the
+-- same way migrations/0004_claims_created_at_id_idx.sql matches the claims list's own cursor
+-- order. See src/db/repositories/outbox.ts and src/db/queries.ts's CLAIM_OUTBOX_BATCH.
+create index outbox_entries_claim_lane_idx on outbox_entries (claim_id, created_at)
+  where status in ('pending', 'leased');
+
+comment on index outbox_entries_claim_lane_idx is
+  'Supports scanning each claim''s own undelivered entries in production order to find its head
+   of line - see MER-405.';
