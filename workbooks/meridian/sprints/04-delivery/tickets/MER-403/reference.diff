+      claimId: entry.claimId,
+      eventType: entry.eventType,
+      payload,
+      attemptCount,
+      lastError: message,
+    })
+    await db.query(DELETE_OUTBOX_ENTRY, [entry.id])
+    return "dead-lettered"
+  }
