new file mode 100644
index 0000000..b5438f1
--- /dev/null
+++ b/migrations/0015_dead_letters.sql
@@ -0,0 +1,30 @@
+-- MER-403: persisted retry state on outbox_entries, and a dead_letters table for entries that
+-- exhaust their retry budget. See src/delivery/retry.ts and src/db/repositories/outbox.ts.
+alter table outbox_entries
+  add column attempt_count integer not null default 0,
+  add column next_attempt_at timestamptz,
+  add column last_error text;
+
+comment on column outbox_entries.attempt_count is
+  'How many delivery attempts this entry has had. Persisted so a process restart does not reset
+   or lose the retry schedule.';
+comment on column outbox_entries.next_attempt_at is
+  'Set after a failed attempt: this entry is not claimable again until now() reaches this value,
+   independent of leased_until. Null means claimable as soon as it is pending (a fresh entry) or
+   its lease expired (MER-402 crash recovery) - the retry schedule imposes no extra wait.';
+
+create table dead_letters (
+  id text primary key,
+  tenant_id text not null,
+  claim_id text not null,
+  event_type text not null,
+  payload text not null,
+  attempt_count integer not null,
+  last_error text not null,
+  created_at timestamptz not null default now()
+);
+
+comment on table dead_letters is
+  'An outbox entry that exhausted its retry budget, or failed with a non-retryable error. The
+   original payload is kept intact - never dropped - so it can be inspected or manually replayed.
+   See src/delivery/retry.ts.';
