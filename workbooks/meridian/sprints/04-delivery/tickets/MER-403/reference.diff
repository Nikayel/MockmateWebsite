+ * MER-403: classifying a delivery failure, and computing when to try again. Replaces the old
+ * `withRetry` - three immediate in-process attempts with nothing spacing them out, which is
+ * exactly why every retry Northwind ever saw landed a fixed interval after the last one: the
+ * real schedule now lives in the persisted `attempt_count`/`next_attempt_at` on each outbox
+ * entry (migrations/0015_dead_letters.sql), advanced by one real attempt per drain cycle, never
+ * by a tight loop inside a single call.
  */
-export async function withRetry<T>(fn: () => Promise<T>, attempts = 3): Promise<T> {
-  let lastError: unknown
-  for (let attempt = 1; attempt <= attempts; attempt++) {
-    try {
-      return await fn()
-    } catch (error) {
-      lastError = error
-    }
-  }
-  throw lastError
+import { addCalendarDays, calendarDateInZone, startOfCalendarDayInZone } from "../domain/calendar-date"
+
+export type FailureClassification = "retryable" | "terminal"
+
+/** Status codes worth trying again: rate-limited, momentarily unavailable, or a transient
+ * gateway/timeout condition. Everything else - a 4xx that isn't 408/429 in particular - means
+ * retrying the exact same request will never succeed. */
+const RETRYABLE_STATUS_CODES = new Set([408, 429, 500, 502, 503, 504])
+
+export interface ClassifyDeliveryFailureInput {
+  /** Null when the request never got a response at all (a network error, a timeout) - worth
+   * retrying, since the endpoint might simply be reachable again next time. */
+  statusCode: number | null
+}
+
+export function classifyDeliveryFailure(input: ClassifyDeliveryFailureInput): FailureClassification {
+  if (input.statusCode === null) return "retryable"
+  return RETRYABLE_STATUS_CODES.has(input.statusCode) ? "retryable" : "terminal"
+}
+
+export interface BackoffScheduleOptions {
+  baseDelayMs: number
+  maxDelayMs: number
+  jitterMs: number
+}
+
+export const DEFAULT_BACKOFF_SCHEDULE: BackoffScheduleOptions = {
+  baseDelayMs: 1_000,
+  maxDelayMs: 5 * 60_000,
+  jitterMs: 2_000,
+}
+
+/** The raw exponential term for `attemptCount` prior failed attempts (0 = computing the delay
+ * before the first retry), with no cap applied - used only to detect whether the schedule has
+ * already reached its ceiling; see `cappedBackoffDelayMs` for the value anything else should
+ * use. */
+function rawExponentialDelayMs(attemptCount: number, options: BackoffScheduleOptions): number {
+  return options.baseDelayMs * 2 ** attemptCount
+}
+
+/** Whether `attemptCount` more failures have already pushed the exponential term to (or past)
+ * `maxDelayMs` on its own - the point past which this schedule stops growing and settles into
+ * MER-403's once-a-day cooldown instead of an ever-tighter loop. */
+export function hasReachedBackoffCap(
+  attemptCount: number,
+  options: BackoffScheduleOptions = DEFAULT_BACKOFF_SCHEDULE
+): boolean {
+  return rawExponentialDelayMs(attemptCount, options) >= options.maxDelayMs
+}
+
+/** The exponential-with-cap delay in milliseconds, BEFORE jitter - doubles per prior attempt,
+ * never past `maxDelayMs`. Jitter (see `jitteredBackoffDelayMs`) is always added on top of this
+ * value, never used in place of the cap: a schedule deep enough to have reached the cap still
+ * has this function return exactly `maxDelayMs`, so jitter never re-opens room the cap closed. */
+export function cappedBackoffDelayMs(
+  attemptCount: number,
+  options: BackoffScheduleOptions = DEFAULT_BACKOFF_SCHEDULE
+): number {
+  return Math.min(rawExponentialDelayMs(attemptCount, options), options.maxDelayMs)
+}
+
+/** `cappedBackoffDelayMs` plus a bounded random addition - always at least the capped value,
+ * never below it, and never more than `jitterMs` above it. */
+export function jitteredBackoffDelayMs(
+  attemptCount: number,
+  options: BackoffScheduleOptions = DEFAULT_BACKOFF_SCHEDULE,
+  random: () => number = Math.random
+): number {
+  return cappedBackoffDelayMs(attemptCount, options) + Math.floor(random() * options.jitterMs)
+}
+
+export interface ComputeNextAttemptAtInput {
+  /** How many attempts have already failed. */
+  attemptCount: number
+  /** Straight from a 429/503's `Retry-After` header, in seconds, when the endpoint sent one -
+   * honored ahead of the default schedule entirely, whatever `attemptCount` says. */
+  retryAfterSeconds: number | null
+  /** The instant this attempt just failed, as an ISO string. */
+  now: string
+  /** The owning tenant's IANA zone - only reached once the schedule has settled into the daily
+   * cooldown tier; see MER-202's src/domain/calendar-date.ts. */
+  timeZone: string
+  options?: BackoffScheduleOptions
+  random?: () => number
+}
+
+/**
+ * The instant an entry becomes claimable again after a failed attempt.
+ *
+ * `Retry-After` wins outright when present. Otherwise: capped exponential backoff plus jitter -
+ * UNLESS the schedule has already reached its cap with no `Retry-After` to go on, in which case
+ * this settles into a once-a-day cooldown, retrying at the START OF THE TENANT'S NEXT CALENDAR
+ * DAY rather than every few minutes forever. That boundary is computed with MER-202's
+ * `calendarDateInZone`/`addCalendarDays`/`startOfCalendarDayInZone` - genuine calendar
+ * arithmetic, resolved back to a real instant using the zone's offset actually in effect on the
+ * target day - never as `now + 24h` of milliseconds. Adding a fixed 24 hours is exactly the
+ * computation a daylight-saving transition between now and then quietly shifts by an hour,
+ * holding the next attempt back an hour past when the tenant's next day has actually started.
+ */
+export function computeNextAttemptAt(input: ComputeNextAttemptAtInput): string {
+  if (input.retryAfterSeconds !== null) {
+    return new Date(new Date(input.now).getTime() + input.retryAfterSeconds * 1000).toISOString()
+  }
+
+  const options = input.options ?? DEFAULT_BACKOFF_SCHEDULE
+  if (hasReachedBackoffCap(input.attemptCount, options)) {
+    const today = calendarDateInZone(input.now, input.timeZone)
+    const tomorrow = addCalendarDays({ date: today, days: 1 })
+    return new Date(startOfCalendarDayInZone(tomorrow, input.timeZone)).toISOString()
+  }
+
+  const random = input.random ?? Math.random
+  const delayMs = jitteredBackoffDelayMs(input.attemptCount, options, random)
+  return new Date(new Date(input.now).getTime() + delayMs).toISOString()
+}
+
+/**
+ * Thrown by src/delivery/webhooks.ts when a delivery attempt fails - carries everything the
+ * outbox drain loop needs to decide what happens next: whether trying again could ever help
+ * (`classification`), when to try again if so (`retryAfterSeconds`, folded into `nextAttemptAt`
+ * by the thrower, which already has the tenant's zone in scope), and the exact payload that was
+ * being sent (`payload`), so a dead-lettered entry keeps it intact rather than losing it.
+ */
+export class DeliveryFailureError extends Error {
+  readonly classification: FailureClassification
+  readonly nextAttemptAt: string
+  readonly payload: string
+
+  constructor(input: { message: string; classification: FailureClassification; nextAttemptAt: string; payload: string }) {
