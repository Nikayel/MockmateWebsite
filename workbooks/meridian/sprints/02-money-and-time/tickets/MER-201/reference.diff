index 0000000..28c2c9f
--- /dev/null
+++ b/migrations/0005_money_minor_units.sql
@@ -0,0 +1,14 @@
+-- MER-201: claims.amount was a floating-point dollar value - every arithmetic step (tax,
+-- discount, per-line allocation) both rounds it and cannot know it just did, which is why
+-- Finance's reconciliation drifted by a cent or two on a different set of claims every month.
+--
+-- Every claim recorded before this migration is USD (see src/domain/claim.ts's old comment:
+-- "always USD today - nothing enforces that"), so backfilling with a fixed *100 is exact for
+-- every existing row. A currency with a different minor-unit scale arriving after this
+-- migration is converted correctly at the application boundary - see src/money/money.ts's
+-- `parseMoney` - not by this one-time backfill.
+alter table claims
+  alter column amount type bigint using round(amount * 100)::bigint;
+
+comment on column claims.amount is
+  'An exact integer count of the currency''s minor unit (cents for USD), never a floating-point dollar value. See src/money/money.ts.';
