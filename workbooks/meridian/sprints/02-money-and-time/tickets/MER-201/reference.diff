diff --git a/src/money/money.ts b/src/money/money.ts
index f32d569..e44fce8 100644
--- a/src/money/money.ts
+++ b/src/money/money.ts
@@ -1,6 +1,109 @@
-/** Dollars, floating point, everywhere in Meridian today. */
-export type Money = number
+/**
+ * Money as an exact value type: an integer count of the currency's minor unit (cents for
+ * USD), paired with the currency code. A plain `number` holds that integer, not the literal
+ * `bigint` primitive - `Number.isSafeInteger` covers every realistic claim amount many times
+ * over, and unlike `bigint`, a `number` survives `JSON.stringify` at the HTTP boundary with no
+ * custom (de)serialization. What matters for MER-201 is that the value is an EXACT INTEGER,
+ * never a fractional dollar amount subject to binary floating-point rounding - see
+ * src/money/round-half-up.ts for the one place any rounding happens.
+ */
 
-export function formatMoney(amount: Money, currency: string): string {
-  return `${currency} ${amount.toFixed(2)}`
+export type CurrencyCode = string
+
+export interface Money {
+  readonly minorUnits: number
+  readonly currency: CurrencyCode
+}
+
+/**
+ * How many minor units make up one major unit, per ISO 4217 - 2 for USD (100 cents to the
+ * dollar), 0 for a currency with no subdivision, 3 for one of the few that has three decimal
+ * places. A currency missing from this table falls back to 2, the overwhelmingly common case,
+ * rather than refusing to parse an amount in a real but unlisted currency.
+ */
+export const MINOR_UNIT_SCALE: Record<string, number> = {
+  USD: 2,
+  EUR: 2,
+  GBP: 2,
+  CAD: 2,
+  AUD: 2,
+  JPY: 0,
+  KRW: 0,
+  BHD: 3,
+  KWD: 3,
+  OMR: 3,
+}
+
+export function minorUnitScale(currency: string): number {
+  return MINOR_UNIT_SCALE[currency] ?? 2
+}
+
+export type ParseMoneyResult = { ok: true; value: Money } | { ok: false; reason: string }
+
+export interface ParseMoneyInput {
+  amount: unknown
+  currency: unknown
+}
+
+/**
+ * Parses a wire-shaped decimal amount (a JSON number expressed in major units - dollars, not
+ * cents) into an exact integer count of minor units. This is the one place a floating-point
+ * amount is allowed to exist in this codebase, and only for as long as it takes to convert it -
+ * every calculation past this function's return statement works in exact minor units.
+ *
+ * Rejects, rather than truncates, an amount that cannot be represented exactly in the target
+ * currency's minor unit - $412.995 has no exact number of cents, and silently dropping the
+ * third decimal digit is exactly the kind of per-request rounding that produced Finance's drift.
+ */
+export function parseMoney(input: ParseMoneyInput): ParseMoneyResult {
+  const { amount, currency } = input
+  if (typeof currency !== "string" || currency.length === 0) {
+    return { ok: false, reason: "currency must be a non-empty string" }
+  }
+  if (typeof amount !== "number" || !Number.isFinite(amount)) {
+    return { ok: false, reason: "amount must be a finite number" }
+  }
+
+  const scale = minorUnitScale(currency)
+  const scaled = amount * 10 ** scale
+  const rounded = Math.round(scaled)
+
+  // `amount * 10 ** scale` is itself floating-point arithmetic, so a value that has an exact
+  // minor-unit representation (412.19 in USD) can still land a hair off the integer (a value
+  // like 41218.999999999996) purely from binary rounding of the multiplication. Comparing
+  // against a tight epsilon - not equality - tells "the true value has more precision than
+  // this currency's minor unit can hold" (412.995 in USD, off by 0.5) apart from "the
+  // multiplication itself introduced noise" (off by a few parts in 10^13).
+  if (Math.abs(scaled - rounded) > 1e-6) {
+    return {
+      ok: false,
+      reason: `amount cannot be represented exactly in ${currency}'s minor unit`,
+    }
+  }
+  if (!Number.isSafeInteger(rounded)) {
+    return { ok: false, reason: "amount is too large to represent exactly" }
+  }
+
+  return { ok: true, value: { minorUnits: rounded, currency } }
+}
+
+/** The exact minor-unit count as a major-unit decimal string, e.g. "412.19" - for display,
+ * never for a further calculation. */
+export function formatMoney(money: Money): string {
+  const scale = minorUnitScale(money.currency)
+  return `${money.currency} ${(money.minorUnits / 10 ** scale).toFixed(scale)}`
+}
+
+/**
+ * The v1 wire representation of an exact `Money` value: a major-unit decimal number, the same
+ * shape this API served before this ticket existed. This is the one v1 money serializer, kept
+ * unchanged by every wire-format change that follows it in this codebase's future. Converting
+ * minor units back to a float is lossless for display (10^-scale of an exact integer is exactly
+ * representable for every scale this table uses), but the result is a float again, which is
+ * exactly why nothing downstream of the HTTP response body may ever read it back in as the
+ * system's source of truth.
+ */
+export function toWireAmountV1(money: Money): number {
+  const scale = minorUnitScale(money.currency)
+  return money.minorUnits / 10 ** scale
 }
diff --git a/src/money/round-half-up.ts b/src/money/round-half-up.ts
index 8683c8c..1894ec8 100644
--- a/src/money/round-half-up.ts
+++ b/src/money/round-half-up.ts
@@ -1,21 +1,63 @@
 /**
- * Rounds a dollar amount to the nearest cent, ties rounding up. `amount` is a plain JavaScript
- * number (see src/money/money.ts), so this is floating point arithmetic scaled by 100, not
- * decimal arithmetic.
+ * The one place any Meridian money calculation rounds a fractional minor-unit amount down to a
+ * whole one. File name is legacy - it shipped as "round half up," which biases every exact
+ * half-cent the same direction and is why Finance's reconciliation drifted by a predictable
+ * amount every month. MER-201 replaces the rounding rule, in this same module, with round-half-
+ * to-even: an exact tie rounds to whichever neighbor is even, so the bias does not accumulate
+ * in one direction over 40,000 claims.
  */
-export function roundHalfUp(amount: number): number {
-  return Math.round(amount * 100) / 100
+import type { Money } from "./money"
+
+/** Round-half-to-even ("banker's rounding") on a fractional minor-unit count. Only ever called
+ * once per calculation - see `allocateRoundedTotal` below for why a second rounding call would
+ * undo the guarantee this function exists to provide. */
+export function roundHalfEven(value: number): number {
+  const floor = Math.floor(value)
+  const diff = value - floor
+  if (diff < 0.5) return floor
+  if (diff > 0.5) return floor + 1
+  return floor % 2 === 0 ? floor : floor + 1
 }
 
 /**
- * Rounds a whole payout and spreads it across `count` equal line items so the parts still
- * sum to the total - the remainder cents land on the first line item.
+ * Splits an exact `total` into `count` line items whose minor units sum back to EXACTLY
+ * `total.minorUnits` - never an approximation, never "off by a cent somewhere." `roundHalfEven`
+ * is called exactly once, to decide each item's base share from `total.minorUnits / count`
+ * (which is almost never a whole number); every minor unit left over after that base share is
+ * placed by exact integer arithmetic, never a second rounding pass. That is the difference
+ * between this function and the old `allocateEvenly` it replaces, which rounded the shared
+ * amount AND rounded the remainder - two rounding points computing over floating-point dollars,
+ * which is exactly how a total stopped summing back to itself.
  */
-export function allocateEvenly(total: number, count: number): number[] {
+export interface AllocateRoundedTotalInput {
+  total: Money
+  count: number
+}
+
+export function allocateRoundedTotal(input: AllocateRoundedTotalInput): Money[] {
+  const { total, count } = input
   if (count <= 0) return []
-  const share = roundHalfUp(total / count)
-  const shares = new Array(count).fill(share)
-  const remainder = roundHalfUp(total - share * count)
-  shares[0] = roundHalfUp(shares[0] + remainder)
-  return shares
+
+  const baseShare = roundHalfEven(total.minorUnits / count)
+  const shares = new Array(count).fill(baseShare) as number[]
+
+  // `residual` is always a whole number of minor units, positive when the base share rounded
+  // down (there is leftover to hand out) and negative when it rounded up (one too many minor
+  // units were handed out and some items must give one back). Placing it one minor unit at a
+  // time, front-loaded, keeps every item within one minor unit of every other and the sum
+  // exact by construction - no further rounding decision is ever made.
+  let residual = total.minorUnits - baseShare * count
+  let index = 0
+  while (residual > 0) {
+    shares[index % count] += 1
+    residual -= 1
+    index += 1
+  }
+  while (residual < 0) {
+    shares[index % count] -= 1
+    residual += 1
+    index += 1
+  }
+
+  return shares.map((minorUnits) => ({ minorUnits, currency: total.currency }))
 }
