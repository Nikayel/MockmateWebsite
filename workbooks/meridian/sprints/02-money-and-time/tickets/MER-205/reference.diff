@@ -0,0 +1,13 @@
+-- MER-205: pins each claim's stored audit hash to the exact projection version it was
+-- computed under, so a later projection change can never make an old, correctly written hash
+-- look tampered - see src/util/canonical-json.ts's AUDIT_PROJECTION_VERSION.
+--
+-- Every claim written before this migration was hashed under projection version 1 (the only
+-- version this codebase has ever had - see MER-203), so backfilling every existing row to 1 is
+-- exact, not a guess.
+alter table claims
+  add column audit_projection_version integer not null default 1;
+
+comment on column claims.audit_projection_version is
+  'Which exact set of fields claims.audit_hash was computed over - see
+   src/util/canonical-json.ts''s AUDIT_PROJECTION_CHANGELOG for what each version number means.';
