+export interface StoredClaimAuditInfo {
+  claim: Claim
+  storedHash: string
+  projectionVersion: number
+}
+
+/**
+ * Fetches a claim together with the exact hash and projection version it was stored under -
+ * never bundled onto `Claim` itself, since hashing a claim that carries its own stored hash
+ * would be hashing the hash. This is what compliance's tamper check reads to verify a claim -
+ * see src/util/canonical-json.ts's `verifyClaimAuditHash`.
+ */
+export async function getStoredClaimAuditInfo(
+  db: DbClient,
+  tenantId: string,
+  claimId: string
+): Promise<StoredClaimAuditInfo | null> {
+  const { rows } = await db.query<ClaimRow>(GET_CLAIM_BY_ID, [tenantId, claimId])
+  const row = rows[0]
+  if (!row) return null
+  return {
+    claim: toClaim(row),
+    storedHash: row.audit_hash,
+    projectionVersion: row.audit_projection_version,
+  }
+}
