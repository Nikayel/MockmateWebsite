diff --git a/src/domain/claim.ts b/src/domain/claim.ts
index a1ddf3a..16071c2 100644
--- a/src/domain/claim.ts
+++ b/src/domain/claim.ts
@@ -28,3 +28,46 @@ export interface CreateClaimInput {
   claimantName: string
   lossDate: string
 }
+
+/**
+ * How many minutes each zone sits from UTC - a single number per zone, the same one all
+ * year round. This is what "the day it was filed" was computed with before MER-202: correct
+ * for whichever season the number was chosen in, and wrong by exactly the daylight-saving
+ * delta for the rest of the year. Real zones do not have one offset; they have a history of
+ * them. See src/domain/calendar-date.ts for the fix.
+ */
+const FIXED_ZONE_OFFSET_MINUTES: Record<string, number> = {
+  "America/Chicago": -360,
+  "America/New_York": -300,
+  "America/Los_Angeles": -480,
+  "America/St_Johns": -210,
+  UTC: 0,
+}
+
+function fixedOffsetMinutesFor(timeZone: string): number {
+  return FIXED_ZONE_OFFSET_MINUTES[timeZone] ?? 0
+}
+
+export interface FiledOnDateInput {
+  createdAt: string
+  timeZone: string
+}
+
+/** The calendar day (YYYY-MM-DD) a claim counts as filed on, in the owning tenant's own zone. */
+export function filedOnDate(input: FiledOnDateInput): string {
+  const offsetMs = fixedOffsetMinutesFor(input.timeZone) * 60_000
+  const localMs = new Date(input.createdAt).getTime() + offsetMs
+  return new Date(localMs).toISOString().slice(0, 10)
+}
+
+export interface ClaimDeadlineInput {
+  createdAt: string
+  timeZone: string
+  days: number
+}
+
+/** A calendar-day deadline, `days` days after the claim's filed-on date. */
+export function computeClaimDeadline(input: ClaimDeadlineInput): string {
+  const deadlineMs = new Date(input.createdAt).getTime() + input.days * 24 * 60 * 60 * 1000
+  return new Date(deadlineMs).toISOString().slice(0, 10)
+}
