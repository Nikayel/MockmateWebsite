index 0000000..cafe9fb
--- /dev/null
+++ b/migrations/0006_claim_dates_and_tenant_zone.sql
@@ -0,0 +1,12 @@
+-- MER-202: a claim's filed-on date and any deadline computed from it need the owning
+-- tenant's own time zone, not the server's - see src/domain/calendar-date.ts.
+--
+-- Every existing tenant predates this column, so it is backfilled to UTC rather than left
+-- null: UTC is not any real tenant's true zone, but it is the same server-time behavior every
+-- tenant silently had before this ticket, so no existing tenant's reported dates move.
+alter table tenants
+  add column time_zone text not null default 'UTC';
+
+comment on column tenants.time_zone is
+  'An IANA time zone name (e.g. America/Chicago) - never a fixed UTC-offset number, which goes
+   wrong the moment the zone observes daylight saving. See src/domain/calendar-date.ts.';
