@@ -0,0 +1,104 @@
+/**
+ * A civil calendar date - "March 8th, 2026" - with no time of day and no time zone. Distinct
+ * from an instant (an ISO-8601 UTC timestamp like `createdAt`) on purpose: the two are never
+ * silently interchangeable past this module's own functions. MER-202 exists because a moment
+ * in time and a calendar day were being treated as the same thing.
+ */
+export interface CalendarDate {
+  readonly year: number
+  readonly month: number // 1-12
+  readonly day: number // 1-31
+}
+
+/** Parses a "YYYY-MM-DD" string into its three numeric parts. Does not validate that the day
+ * is in range for the month - every caller in this codebase only ever feeds this a string this
+ * module or the database itself produced. */
+export function calendarDateFromISO(iso: string): CalendarDate {
+  const [year, month, day] = iso.split("-").map(Number)
+  return { year, month, day }
+}
+
+export function calendarDateToISO(date: CalendarDate): string {
+  const year = String(date.year).padStart(4, "0")
+  const month = String(date.month).padStart(2, "0")
+  const day = String(date.day).padStart(2, "0")
+  return `${year}-${month}-${day}`
+}
+
+export interface CompareCalendarDatesInput {
+  a: CalendarDate
+  b: CalendarDate
+}
+
+export function compareCalendarDates(input: CompareCalendarDatesInput): number {
+  return calendarDateToISO(input.a).localeCompare(calendarDateToISO(input.b))
+}
+
+export interface AddCalendarDaysInput {
+  date: CalendarDate
+  days: number
+}
+
+/**
+ * Adds `days` calendar days to `date` and returns the resulting calendar date - month and
+ * year rollover, leap years, all handled by delegating to `Date.UTC`'s own day-overflow
+ * arithmetic. This never touches a clock or a time zone, so a daylight-saving transition
+ * anywhere in the window has no way to reach it: adding calendar days to a calendar date is
+ * arithmetic on a calendar, not on time.
+ */
+export function addCalendarDays(input: AddCalendarDaysInput): CalendarDate {
+  const { date, days } = input
+  const utcMidnight = new Date(Date.UTC(date.year, date.month - 1, date.day))
+  utcMidnight.setUTCDate(utcMidnight.getUTCDate() + days)
+  return {
+    year: utcMidnight.getUTCFullYear(),
+    month: utcMidnight.getUTCMonth() + 1,
+    day: utcMidnight.getUTCDate(),
+  }
+}
+
+/**
+ * The real UTC offset, in minutes, a given IANA time zone was actually observing at
+ * `instantMs` - read out of the JS engine's own tz database via `Intl`, so a date inside a
+ * daylight-saving transition gets the offset that transition actually put in effect, never a
+ * fixed year-round number. This is the one place this module reads real-world zone rules.
+ */
+function utcOffsetMinutesAt(instantMs: number, timeZone: string): number {
+  const parts = new Intl.DateTimeFormat("en-US", { timeZone, timeZoneName: "shortOffset" }).formatToParts(
+    new Date(instantMs)
+  )
+  const offsetText = parts.find((part) => part.type === "timeZoneName")?.value ?? "GMT+0"
+  const match = offsetText.match(/GMT([+-])(\d{1,2})(?::(\d{2}))?/)
+  if (!match) return 0
+  const sign = match[1] === "-" ? -1 : 1
+  const hours = Number(match[2])
+  const minutes = match[3] ? Number(match[3]) : 0
+  return sign * (hours * 60 + minutes)
+}
+
+/**
+ * The calendar date `instantIso` falls on when read in `timeZone` - not the server's zone, not
+ * UTC. Uses `Intl.DateTimeFormat` against the real tz database, so a half-hour offset and a
+ * daylight-saving transition are both handled by the same code path that handles every other
+ * zone, rather than a special case.
+ */
+export function calendarDateInZone(instantIso: string, timeZone: string): CalendarDate {
+  const formatter = new Intl.DateTimeFormat("en-CA", {
+    timeZone,
+    year: "numeric",
+    month: "2-digit",
+    day: "2-digit",
+  })
+  return calendarDateFromISO(formatter.format(new Date(instantIso)))
+}
+
+/** The first instant (as epoch milliseconds) of `date`'s calendar day in `timeZone` - midnight
+ * local time, converted to UTC using the offset actually in effect at that moment. Exported for
+ * a deadline that needs to become a real instant later (a scheduler, an alert) rather than stay
+ * a calendar date forever - not currently called inside this ticket's own HTTP surface, whose
+ * deadlines are reported as calendar dates. */
+export function startOfCalendarDayInZone(date: CalendarDate, timeZone: string): number {
+  const naiveUtcMs = Date.UTC(date.year, date.month - 1, date.day)
+  const offsetMinutes = utcOffsetMinutesAt(naiveUtcMs, timeZone)
+  return naiveUtcMs - offsetMinutes * 60_000
+}
