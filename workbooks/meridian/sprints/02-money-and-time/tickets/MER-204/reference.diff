diff --git a/src/http/subscription-version.ts b/src/http/subscription-version.ts
new file mode 100644
index 0000000..3eaa9d7
--- /dev/null
+++ b/src/http/subscription-version.ts
@@ -0,0 +1,34 @@
+/**
+ * Which wire shape a subscription (tenant) gets on `GET /claims`. The new minor-unit money
+ * format and the old v1 shape both need to keep shipping at once - see MER-204 - so a
+ * subscription's version is read from its own request header, pinned the first time it is
+ * seen, and honored on every request after that even when the header is absent.
+ */
+export type EnvelopeVersion = "v1" | "v2"
+
+const VERSION_HEADER = "x-api-version"
+
+/** Reads the version a request explicitly asked for, from its own header - never a query
+ * parameter, so version negotiation can never collide with an operation's own query
+ * parameters, which is the exact ambiguity this ticket exists to avoid reintroducing. Returns
+ * `null` for a request that did not ask, which is not the same as asking for v1. */
+export function requestedVersion(headers: Record<string, string>): EnvelopeVersion | null {
+  const raw = headers[VERSION_HEADER]
+  if (raw === "2") return "v2"
+  if (raw === "1") return "v1"
+  return null
+}
+
+/**
+ * The version this request actually gets: whatever it explicitly asked for, else the
+ * subscription's own pinned version, else v1. A request that sends no version information at
+ * all, and whose subscription has never pinned one either, gets exactly the response shape
+ * this API served before this ticket - the whole sprint-1 regression column depends on this
+ * defaulting to v1, never to the newest version.
+ */
+export function resolveEnvelopeVersion(
+  requested: EnvelopeVersion | null,
+  pinned: EnvelopeVersion | null
+): EnvelopeVersion {
+  return requested ?? pinned ?? "v1"
+}
