+-- MER-204: a subscription's pinned wire version. Null until a request explicitly asks for one,
+-- which resolves to v1 by default - see src/http/subscription-version.ts. Every existing
+-- tenant predates this column and is left null on purpose: an existing integration that has
+-- never sent a version keeps getting v1, exactly what it already depended on.
+alter table tenants
+  add column pinned_envelope_version text;
+
+alter table tenants
+  add constraint tenants_pinned_envelope_version_check
+  check (pinned_envelope_version is null or pinned_envelope_version in ('v1', 'v2'));
+
+comment on column tenants.pinned_envelope_version is
+  'The wire version (v1 or v2) this subscription is pinned to, once it has asked for one
+   explicitly. Null means "never asked" - defaults to v1, never to the newest version. See
+   src/http/subscription-version.ts.';
