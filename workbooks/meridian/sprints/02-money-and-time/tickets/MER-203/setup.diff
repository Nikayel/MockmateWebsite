diff --git a/src/util/canonical-json.ts b/src/util/canonical-json.ts
new file mode 100644
index 0000000..63da1e5
--- /dev/null
+++ b/src/util/canonical-json.ts
@@ -0,0 +1,30 @@
+/**
+ * PR #418's audit-hash fix: hash whatever `JSON.stringify` produces at write time, and the
+ * same call again at check time. Passes locally, because within one process a claim built the
+ * same way always gets the same key order - see MER-203 for why that guarantee does not
+ * survive a database round trip.
+ */
+import type { Claim } from "../domain/claim"
+
+function fnv1a(bytes: string): string {
+  let hash = 0x811c9dc5
+  for (let i = 0; i < bytes.length; i++) {
+    hash ^= bytes.charCodeAt(i)
+    hash = Math.imul(hash, 0x01000193)
+  }
+  return (hash >>> 0).toString(16).padStart(8, "0")
+}
+
+export function hashClaim(claim: Claim): string {
+  return fnv1a(JSON.stringify(claim))
+}
+
+export interface VerifyClaimAuditHashInput {
+  claim: Claim
+  storedHash: string
+}
+
+/** Compliance's tamper check: recompute the hash the same way it was written, and compare. */
+export function verifyClaimAuditHash(input: VerifyClaimAuditHashInput): boolean {
+  return hashClaim(input.claim) === input.storedHash
+}
