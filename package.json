{
  "name": "codesparring-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "predev": "node scripts/predev-exfat-guard.js",
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css}\"",
    "typecheck": "tsc --noEmit",
    "check:theme": "node scripts/check-theme-tokens.mjs",
    "start": "next start",
    "test": "vitest run",
    "audit:bugfix": "tsx scripts/audit-bugfix-scenarios.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "firebase emulators:exec --only firestore --project codesparring-integration \"vitest run --config vitest.integration.config.ts\"",
    "prepare": "husky"
  },
