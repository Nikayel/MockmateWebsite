# ===========================================
# MOCKMATE ENVIRONMENT CONFIGURATION
# ===========================================

# ---- AI providers, in fallback order: OpenAI -> DeepSeek -> Gemini ----
# The chain is defined in FALLBACK_ORDER (lib/ai-providers.ts). Each capability
# leads with GPT-5.6 Luna at a reasoning effort chosen for that path, then
# DeepSeek V4, then Gemini. A missing key disables that rung rather than
# failing: the chain degrades to whatever is configured.

# OpenAI - PRIMARY. Required in production; without it every capability starts
# one rung down the chain. https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek - second rung. https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Google Gemini API Configuration
# Third rung, and still the sole provider for embeddings.
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model pin overrides (see lib/ai/model-ids.ts). Set these to migrate
# off a retired model without a code change, then redeploy.
# OPENAI_MODEL_LUNA=gpt-5.6-luna
# DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
# DEEPSEEK_MODEL_PRO=deepseek-v4-pro
# GEMINI_MODEL_FLASH=gemini-3.6-flash
# GEMINI_MODEL_FLASH_LITE=gemini-3.5-flash-lite

# Supabase Configuration
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# GitHub OAuth (Optional - for authentication)
# Set up OAuth app at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Application Settings
#
# NEXT_PUBLIC_APP_URL is where Stripe returns the customer after checkout and
# where the billing portal returns them afterwards. In PRODUCTION this must be
# https://www.codesparring.dev (the www host is canonical; the apex 308s to it).
# It also has to match the origin registered on the Stripe webhook endpoint.
#
# If it is unset the code now falls back to the canonical SITE_ORIGIN rather than
# localhost, so an unset value is no longer a broken checkout, but set it anyway
# so the value is explicit.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Google Search Console Verification
# Get this from: https://search.google.com/search-console
# After adding your property, choose HTML tag method and copy the content value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_site_verification_code_here

# ===========================================
# FIREBASE CLIENT SDK (REQUIRED - the app cannot boot without these)
# ===========================================

# These seven were missing from this file entirely, which meant anyone
# provisioning a deployment from it got an app that could not initialize
# Firebase at all. They are NEXT_PUBLIC_ by design: the Firebase web config is
# not a secret, and security is enforced by firestore.rules, not by hiding it.
# Get these from: Firebase Console > Project Settings > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456
# Optional. Enables Firebase Analytics (GA4). Leave unset to keep it off.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ===========================================
# FIREBASE ADMIN SDK CONFIGURATION
# ===========================================

# The Admin SDK reads ONE variable: the whole service-account JSON as a single
# string. This file previously documented a FIREBASE_ADMIN_PROJECT_ID /
# _CLIENT_EMAIL / _PRIVATE_KEY trio that lib/firebase-admin.ts does not read,
# so a deployment provisioned from it had no working Admin SDK: server auth,
# every cron, and the Stripe webhook would all fail at runtime.
#
# Paste the downloaded JSON as one line (quotes included).
# Get it from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}'

# Admin User ID (for identifying admin users in the system)
# Set this to your Firebase Auth UID for admin access
ADMIN_USER_ID=your_firebase_user_id_here

# Protected Admin Emails (comma-separated list of emails that cannot be deleted)
# These accounts are protected from deletion via the admin API
ADMIN_PROTECTED_EMAILS=admin1@example.com,admin2@example.com

# ===========================================
# STRIPE PAYMENT CONFIGURATION
# ===========================================

# Stripe API Keys
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here

# Stripe Webhook Secret
# Get from: Stripe Dashboard > Developers > Webhooks > Your Endpoint > Signing Secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs. NOT optional: app/api/create-checkout/route.ts whitelists the
# price by building one of these four names and rejects anything that does not
# start with "price_", so checkout returns a generic 500 when the matching one is
# unset. This file previously documented STRIPE_PRO_MONTHLY_PRICE_ID and
# STRIPE_PRO_YEARLY_PRICE_ID, which no code reads.
#
# The website pair is what the web app uses. Leave the vscode pair unset until
# the extension ships: the platform is chosen by the CLIENT, so setting
# STRIPE_PRICE_ID_VSCODE while it points at a cheaper price would let anyone post
# {"platform":"vscode"} and buy the web product at the extension's rate.
STRIPE_PRICE_ID_WEBSITE=price_xxxxx
STRIPE_PRICE_ID_WEBSITE_YEARLY=price_xxxxx
# STRIPE_PRICE_ID_VSCODE=price_xxxxx
# STRIPE_PRICE_ID_VSCODE_YEARLY=price_xxxxx

# ===========================================
# RAG SYSTEM CONFIGURATION
# ===========================================

# Embedding Model: Gemini text-embedding-004 (Primary - 768 dimensions)
# Gemini embeddings are used by default when GEMINI_API_KEY is set
# No additional configuration needed

# OpenAI embeddings (fallback when Gemini embeddings fail).
# Uses the SAME OPENAI_API_KEY declared at the top of this file, where OpenAI is
# the primary chat provider. Do not add a second OPENAI_API_KEY line here: in a
# dotenv file the last assignment wins, so a duplicate silently overrides the
# real one.
# Optional: Choose OpenAI embedding model (default: text-embedding-3-small)
# Options: text-embedding-3-small (fastest), text-embedding-3-large (highest quality)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pinecone Vector Database (for RAG)
# Get your API key from: https://app.pinecone.io/
# When set, RAG will use Pinecone instead of Firestore for vector search
PINECONE_API_KEY=your_pinecone_api_key_here
# Index name - default is skillon-raggemini (768 dimensions for Gemini embeddings)
# Supported dimensions: 768 (Gemini), 1536 (OpenAI), 256 (TF-IDF fallback)
PINECONE_INDEX_NAME=skillon-raggemini
# Set to 'false' to disable Pinecone even when API key is set
# USE_PINECONE=true

# ===========================================
# VOICE TRANSCRIPTION (for spoken interviews)
# ===========================================

# Deepgram API Configuration (Primary - for real-time voice transcription)
# Get your API key from: https://console.deepgram.com/
# Enables high-quality real-time speech-to-text for interview conversations
DEEPGRAM_API_KEY=your_deepgram_api_key_here
# If not set, falls back to browser's Web Speech API
#
# /api/voice/token grants a short-lived token per request (POST /v1/auth/grant) so
# the browser never receives the long-lived account key. This only requires
# DEEPGRAM_API_KEY to have at least Member permission -- no keys:write scope and no
# project id, both of which the previous key-minting approach needed.
# If the grant fails the route returns 503 and voice degrades to typed input; it
# never falls back to serving the account key.

# ===========================================
# EMAIL NOTIFICATIONS (Brevo)
# ===========================================

# Brevo (formerly Sendinblue) API Key
# Get your API key from: https://app.brevo.com/settings/keys/api
# Used for transactional emails: welcome, inactivity reminders, spaced repetition
BREVO_API_KEY=your_brevo_api_key_here

# ===========================================
# RATE LIMITING (Distributed)
# ===========================================

# Upstash Redis (Recommended for Vercel - fastest distributed rate limiting)
# Get from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Alternative: Use Firestore for rate limiting (enabled by default if Firebase is configured)
# USE_FIRESTORE_RATE_LIMIT=true

# ===========================================
# ERROR MONITORING & OBSERVABILITY
# ===========================================

# Sentry (Error Tracking) - ACTIVE when set
# Errors and warnings are sent to Sentry via the ingestion API (no SDK/bundle cost).
# Get your DSN from: https://sentry.io/  (Project Settings -> Client Keys (DSN))
SENTRY_DSN=https://your-sentry-dsn@o123456.ingest.sentry.io/1234567

# LogFlare (Log Aggregation) - Optional
# Get from: https://logflare.app/
LOGFLARE_API_KEY=your_logflare_api_key_here
LOGFLARE_SOURCE_ID=your_logflare_source_id_here

# Custom Error Webhook (Optional)
# Sends error notifications to a custom webhook (e.g., Slack, Discord)
ERROR_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# ===========================================
# CRON JOBS & SCHEDULED TASKS
# ===========================================

# Cron job secret (required for securing cron endpoints)
# Generate a random string: openssl rand -hex 32
#
# ALSO required for AI cost accounting. The Edge feedback route cannot reach
# Firebase Admin, so it reports its spend server-to-server to
# /api/internal/usage using this bearer. Without it that route records nothing:
# the admin dashboard under-reports, and per-user AI budget caps never see
# feedback generation. The reporter logs a warning and continues rather than
# failing the user's response.
CRON_SECRET=your_cron_secret_here

# ===========================================
# SECURITY
# ===========================================

# CSRF Secret (for state-changing API operations)
# Generate: openssl rand -hex 32
# CSRF_SECRET=your_csrf_secret_here

# Request Signing Secret (for webhook verification)
# Generate: openssl rand -hex 32
# WEBHOOK_SIGNING_SECRET=your_webhook_signing_secret_here

# ===========================================
# GUEST / EVENT MODE
# ===========================================

# Guest interview-session creations allowed per hour per IP (default 3).
# Raise temporarily (e.g. 50) for events where a whole room shares one NAT'd IP
# (career-fair tables, lecture-hall demos); unset again after the event.
# GUEST_SESSION_LIMIT_PER_HOUR=50

# ===========================================
# AI MODEL MIGRATION
# ===========================================

# Override the pinned Gemini models without a code change (see lib/ai/model-ids.ts).
# Pin explicit versions, never the rolling *-latest aliases. gemini-2.5-flash is
# scheduled to deprecate 2026-10-16; verify a successor first:
#   node scripts/ai-fallback-drill.mjs --candidate <model>
# GEMINI_MODEL_FLASH=gemini-3.5-flash
# GEMINI_MODEL_FLASH_LITE=gemini-3.1-flash-lite
