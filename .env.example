# ===========================================
# MOCKMATE ENVIRONMENT CONFIGURATION
# ===========================================

# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
# Used for AI chat responses AND embeddings (text-embedding-004)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# GitHub OAuth (Optional - for authentication)
# Set up OAuth app at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Google Search Console Verification
# Get this from: https://search.google.com/search-console
# After adding your property, choose HTML tag method and copy the content value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_site_verification_code_here

# ===========================================
# FIREBASE ADMIN SDK CONFIGURATION
# ===========================================

# Firebase Admin SDK credentials
# Get these from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_ADMIN_PROJECT_ID=your_firebase_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Admin User ID (for identifying admin users in the system)
# Set this to your Firebase Auth UID for admin access
ADMIN_USER_ID=your_firebase_user_id_here

# Protected Admin Emails (comma-separated list of emails that cannot be deleted)
# These accounts are protected from deletion via the admin API
ADMIN_PROTECTED_EMAILS=admin1@example.com,admin2@example.com

# ===========================================
# STRIPE PAYMENT CONFIGURATION
# ===========================================

# Stripe API Keys
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here

# Stripe Webhook Secret
# Get from: Stripe Dashboard > Developers > Webhooks > Your Endpoint > Signing Secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (optional - can be set in lib/config.ts)
# STRIPE_PRO_MONTHLY_PRICE_ID=price_xxxxx
# STRIPE_PRO_YEARLY_PRICE_ID=price_xxxxx

# ===========================================
# RAG SYSTEM CONFIGURATION
# ===========================================

# Embedding Model: Gemini text-embedding-004 (Primary - 768 dimensions)
# Gemini embeddings are used by default when GEMINI_API_KEY is set
# No additional configuration needed

# OpenAI API Configuration (Fallback for embeddings)
# Get your API key from: https://platform.openai.com/api-keys
# Only used if Gemini embeddings fail - text-embedding-3-small (1536 dimensions)
OPENAI_API_KEY=your_openai_api_key_here
# Optional: Choose OpenAI embedding model (default: text-embedding-3-small)
# Options: text-embedding-3-small (fastest), text-embedding-3-large (highest quality)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pinecone Vector Database (for RAG)
# Get your API key from: https://app.pinecone.io/
# When set, RAG will use Pinecone instead of Firestore for vector search
PINECONE_API_KEY=your_pinecone_api_key_here
# Index name - default is skillon-raggemini (768 dimensions for Gemini embeddings)
# Supported dimensions: 768 (Gemini), 1536 (OpenAI), 256 (TF-IDF fallback)
PINECONE_INDEX_NAME=skillon-raggemini
# Set to 'false' to disable Pinecone even when API key is set
# USE_PINECONE=true

# ===========================================
# VOICE TRANSCRIPTION (for spoken interviews)
# ===========================================

# Deepgram API Configuration (Primary - for real-time voice transcription)
# Get your API key from: https://console.deepgram.com/
# Enables high-quality real-time speech-to-text for interview conversations
DEEPGRAM_API_KEY=your_deepgram_api_key_here
# If not set, falls back to browser's Web Speech API
#
# /api/voice/token mints a short-lived, usage:write-only key per request so the
# browser never receives the long-lived account key. This requires DEEPGRAM_API_KEY
# to have the keys:write scope. Optionally pin the project id to skip a lookup:
# DEEPGRAM_PROJECT_ID=your_deepgram_project_id
# If minting is unavailable, the route falls back to returning the account key.

# ===========================================
# EMAIL NOTIFICATIONS (Brevo)
# ===========================================

# Brevo (formerly Sendinblue) API Key
# Get your API key from: https://app.brevo.com/settings/keys/api
# Used for transactional emails: welcome, inactivity reminders, spaced repetition
BREVO_API_KEY=your_brevo_api_key_here

# ===========================================
# RATE LIMITING (Distributed)
# ===========================================

# Upstash Redis (Recommended for Vercel - fastest distributed rate limiting)
# Get from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Alternative: Use Firestore for rate limiting (enabled by default if Firebase is configured)
# USE_FIRESTORE_RATE_LIMIT=true

# ===========================================
# ERROR MONITORING & OBSERVABILITY
# ===========================================

# Sentry (Error Tracking) - ACTIVE when set
# Errors and warnings are sent to Sentry via the ingestion API (no SDK/bundle cost).
# Get your DSN from: https://sentry.io/  (Project Settings -> Client Keys (DSN))
SENTRY_DSN=https://your-sentry-dsn@o123456.ingest.sentry.io/1234567

# LogFlare (Log Aggregation) - Optional
# Get from: https://logflare.app/
LOGFLARE_API_KEY=your_logflare_api_key_here
LOGFLARE_SOURCE_ID=your_logflare_source_id_here

# Custom Error Webhook (Optional)
# Sends error notifications to a custom webhook (e.g., Slack, Discord)
ERROR_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# ===========================================
# CRON JOBS & SCHEDULED TASKS
# ===========================================

# Cron job secret (required for securing cron endpoints)
# Generate a random string: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# ===========================================
# SECURITY
# ===========================================

# CSRF Secret (for state-changing API operations)
# Generate: openssl rand -hex 32
# CSRF_SECRET=your_csrf_secret_here

# Request Signing Secret (for webhook verification)
# Generate: openssl rand -hex 32
# WEBHOOK_SIGNING_SECRET=your_webhook_signing_secret_here

# ===========================================
# GUEST / EVENT MODE
# ===========================================

# Guest interview-session creations allowed per hour per IP (default 3).
# Raise temporarily (e.g. 50) for events where a whole room shares one NAT'd IP
# (career-fair tables, lecture-hall demos); unset again after the event.
# GUEST_SESSION_LIMIT_PER_HOUR=50

# ===========================================
# AI MODEL MIGRATION
# ===========================================

# Override the pinned Gemini models without a code change (see lib/ai/model-ids.ts).
# Pin explicit versions, never the rolling *-latest aliases. gemini-2.5-flash is
# scheduled to deprecate 2026-10-16; verify a successor first:
#   node scripts/ai-fallback-drill.mjs --candidate <model>
# GEMINI_MODEL_FLASH=gemini-3.5-flash
# GEMINI_MODEL_FLASH_LITE=gemini-3.1-flash-lite
