{
  "buildCommand": "pnpm run build",
  "devCommand": "pnpm run dev",
  "installCommand": "pnpm install",
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    },
    "app/api/execute/route.ts": {
      "maxDuration": 30
    },
    "app/api/chat/route.ts": {
      "maxDuration": 30
    },
    "app/api/generate-feedback/route.ts": {
      "maxDuration": 30
    },
    "app/api/cron/email-notifications/route.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/aggregate-usage",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/subscription-reconcile",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/subscription-expiry",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/expire-referral-rewards",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/guest-session-cleanup",
      "schedule": "0 10 * * *"
    }
  ]
}
