# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
package-lock.json
yarn.lock

# OS / editor artifacts
.DS_Store
**/.DS_Store
._*
**/._*

# next.js
/.next/
/out/

# test artifacts
/playwright-report/
/test-results/
/coverage/
# Generated audit reports (pnpm seo:audit). Regenerated from a live crawl on every run, so a
# committed copy is stale the moment the site changes; read the run's own output instead.
/artifacts/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code
.agents/CLAUDE.md
.agents/AI_ASSISTANT.md
.claude/settings.local.json
.claude/commands/
.claude/skills/

# Local assistant planning notes
/PLAN.md
/immediate_fixes.md

# Extension directory (cloned repo for context, not part of website build)
/extension/

# Allow documentation files
!README.md
!SECURITY.md
!CONTRIBUTING.md
!CHANGELOG.md
!docs/*.md
# ...but the `!docs/*.md` rule above re-includes macOS AppleDouble files like
# docs/._BACKEND.md (they match docs/*.md). Re-exclude them explicitly.
docs/._*

# Local generated docs
/docs/ai-engineer-intern-interview-guide.html

# Ignore constitution files
/constitution/

# Future Sprints
/future-sprints/

# Vendored TypeScript compiler build for the Sprint Labs worker
# (public/vendor/typescript/typescript.js). Regenerated from node_modules/typescript by
# scripts/copy-ts-vendor.mjs on every `pnpm install` (postinstall); never commit it, or it will
# drift from the pinned devDependency version instead of tracking it. Scoped to this one
# subdirectory, not all of public/vendor/, so a future hand-committed vendor asset elsewhere under
# public/vendor/ is not silently swallowed by this rule.
/public/vendor/typescript/

# Vendored PGlite (Postgres-in-WASM) browser build for the Sprint Labs pg-sandbox worker (every
# top-level .js/.wasm/.data file under @electric-sql/pglite's dist/, glob-copied by
# scripts/copy-pglite-vendor.mjs -- see that script's header for why a glob, not a fixed list).
# Regenerated on every `pnpm install` (postinstall); never commit it, for the same drift reason as
# the TypeScript vendor copy above. Scoped to this one subdirectory, not all of public/wasm/, so the
# existing committed public/wasm/sql-wasm.{js,wasm} (sql.js, a different engine) is untouched.
/public/wasm/pglite/

# Firebase emulator artifacts (pnpm test:integration)
firestore-debug.log
firebase-debug.log
ui-debug.log
/.firebase/

# Graphify cache (41 MB, regenerated every session — untracked in DEAD-11) + local scratch
/graphify-out/
scratch.ts
patch_runners.py
eslint-results.json

# Security audit working notes. This repository is PUBLIC, and these documents name
# UNFIXED vulnerabilities with exact file:line, which is a roadmap for anyone who reads
# them before the fixes land. They are meant to be read by whoever is doing the work, on
# the machine doing the work, and nowhere else. Keep them local.
/NAIVETY-AUDIT-FIXES.md

# Scratch pairing file kept locally. Untracked and NOT ignored until now, which with the
# demonstrated git-add contamination made it one stray `git add -A` from being committed.
learning.html
