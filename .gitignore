package-lock.json
yarn.lock

# OS / editor artifacts
.DS_Store
**/.DS_Store

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example
.env.local

# vercel
.vercel

